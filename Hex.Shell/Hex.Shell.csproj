<Project Sdk="Microsoft.NET.Sdk">

  <!-- What Dawn and Dusk are both drawn with and both are, the window's identity, the settings page, the chrome they share -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <HorizonRoot Condition="'$(HorizonRoot)' == ''">$(MSBuildThisFileDirectory)..\horizon\</HorizonRoot>
  </PropertyGroup>

  <!-- Hex's icon, the one both modes' windows and the exe have, Dusk is Hex too -->
  <ItemGroup>
    <None Update="Assets\hex_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The looks are worked on a HexSettings, which is Hex.Core's own, so what does that is the modes' and nobody else's -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hex" />
    <InternalsVisibleTo Include="Hex.Dawn" />
    <InternalsVisibleTo Include="Hex.Dusk" />
    <InternalsVisibleTo Include="Hex.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hex.Core\Hex.Core.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon\Horizon.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon.UI\Horizon.UI.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon.HIDL\Horizon.HIDL.csproj" />
  </ItemGroup>

</Project>
