<Project>
  <!--
    Hex's version, the one place it's said. Every Hex project gets it (the exe, Dawn, Dusk, the core and the shell),
    so the About box, Dusk's banner, the HIDL server and the update check all say the same thing. It was in three
    project files and the other two came out as 1.0.0. An engine cloned into horizon/ finds this file too walking up,
    and keeps its own version, hence going by the project's name.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Hex'))">
    <Version>3.1.1</Version>
    <!-- What this release is called, said after the number wherever a person reads it (2.8.0 thickboy), empty for none -->
    <VersionName>Amphetamine</VersionName>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Hex')) and '$(VersionName)' != ''">
    <AssemblyMetadata Include="VersionName" Value="$(VersionName)" />
  </ItemGroup>
  <!--
    Which Hex a build is, stable unless the nightly build says dev (dotnet publish -p:HexChannel=dev -p:HexNightly=nightly-57),
    and the nightly release it goes out as, so a dev build updates from the nightlies and knows which one it is
  -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Hex'))">
    <AssemblyMetadata Include="Channel" Value="$(HexChannel)" Condition="'$(HexChannel)' != ''" />
    <AssemblyMetadata Include="Nightly" Value="$(HexNightly)" Condition="'$(HexNightly)' != ''" />
  </ItemGroup>

  <!--
    MSBuild stops at the first Directory.Build.props it finds, so the workspace's one above (the shared engine
    checkout) is brought in by hand when there is one. A clone on its own has none and goes by the engine cloned
    into horizon/, the way CI does it.
  -->
  <PropertyGroup>
    <WorkspaceProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))</WorkspaceProps>
  </PropertyGroup>
  <Import Project="$(WorkspaceProps)" Condition="'$(WorkspaceProps)' != '' and Exists('$(WorkspaceProps)')" />
</Project>
