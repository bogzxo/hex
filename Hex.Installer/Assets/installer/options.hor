// Installation preferences, shown by Customize. Names are bound in InstallerScene.
#define layout
let options_window = compositor.window({
    size: vec(660, 440), visible: false, title: "@installer.integration.title", icon: "settings-gear",
    resize_grip: false, movable: false, padding: vec(24, 18, 24, 20), lift: 28,
    intro: "fade", intro_time: 0.16,
});
let options_body = compositor.stack({ parent: options_window, fill: "both", spacing: 12 });
let options_description = compositor.label({ parent: options_body, size: vec(612, 36), text: "@installer.integration.description", text_scale: 0.135, wrap: true, dim: true, align: "top_left" });
let options_columns = compositor.stack({ parent: options_body, direction: "horizontal", spacing: 20 });
let options_shortcuts = compositor.stack({ parent: options_columns, spacing: 10 });
let shortcuts_heading = compositor.label({ parent: options_shortcuts, size: vec(296, 20), text: "@installer.integration.shortcuts_heading", text_scale: 0.12, dim: true, align: "top_left" });
let desktop_hex = compositor.toggle({ parent: options_shortcuts, size: vec(296, 28), label: "@installer.integration.desktop_hex", state: true, lbl_scale: 0.135 });
let desktop_dusk = compositor.toggle({ parent: options_shortcuts, size: vec(296, 28), label: "@installer.integration.desktop_dusk", state: false, lbl_scale: 0.135 });
let application_menu = compositor.toggle({ parent: options_shortcuts, size: vec(296, 28), label: "@installer.integration.menu_linux", state: true, lbl_scale: 0.135 });
let menu_dusk = compositor.toggle({ parent: options_shortcuts, size: vec(296, 28), label: "@installer.integration.menu_dusk", state: true, lbl_scale: 0.135 });
let windows_app_paths = compositor.toggle({ parent: options_shortcuts, size: vec(296, 28), label: "@installer.integration.app_paths", state: true, lbl_scale: 0.135, tooltip: "@installer.integration.app_paths_help" });
let options_modules = compositor.stack({ parent: options_columns, spacing: 10 });
let modules_heading = compositor.label({ parent: options_modules, size: vec(296, 20), text: "@installer.modules.heading", text_scale: 0.12, dim: true, align: "top_left" });
let module_link = compositor.toggle({ parent: options_modules, size: vec(296, 28), label: "@installer.modules.link", state: true, lbl_scale: 0.135, tooltip: "@installer.modules.link_help" });
let module_local_ai = compositor.toggle({ parent: options_modules, size: vec(296, 28), label: "@installer.modules.local_ai", state: true, lbl_scale: 0.135, tooltip: "@installer.modules.local_ai_help" });
let module_agentic = compositor.toggle({ parent: options_modules, size: vec(296, 28), label: "@installer.modules.agentic", state: true, lbl_scale: 0.135, tooltip: "@installer.modules.agentic_help" });
let module_notebooks = compositor.toggle({ parent: options_modules, size: vec(296, 28), label: "@installer.modules.notebooks", state: true, lbl_scale: 0.135, tooltip: "@installer.modules.notebooks_help" });
let module_designer = compositor.toggle({ parent: options_modules, size: vec(296, 28), label: "@installer.modules.designer", state: true, lbl_scale: 0.135, tooltip: "@installer.modules.designer_help" });
let options_note = compositor.label({ parent: options_body, size: vec(612, 26), text: "@installer.integration.note", text_scale: 0.115, dim: true, wrap: true, align: "top_left" });
let options_buttons = compositor.stack({ parent: options_body, direction: "horizontal", spacing: 12, anchor: "right", pivot: "right" });
let options_cancel = compositor.button({ parent: options_buttons, size: vec(100, 36), label: "@installer.actions.cancel", style: "button_flat" });
let options_apply = compositor.button({ parent: options_buttons, size: vec(140, 36), label: "@installer.integration.apply", primary: true });
