<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hex, the program. Started plainly it is Dawn, the editor, started with dusk (or as dusk.exe) it is Dusk, the
       terminal, in a window of its own that Windows counts as another program (HexIdentity). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AttachConsole for the help, LibraryImport writes unsafe code for it -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <Version>0.3.0</Version>

    <!-- The exe's icon in Explorer, the windows get their own at run time (WindowIcon) -->
    <ApplicationIcon>..\Hex.Shell\Assets\hex_icon.ico</ApplicationIcon>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <HorizonRoot Condition="'$(HorizonRoot)' == ''">$(MSBuildThisFileDirectory)..\horizon\</HorizonRoot>
  </PropertyGroup>

  <!--
    Publishing: dotnet publish -c Release -r win-x64
    That makes a native Hex.exe (trimmed, no .NET needed on the machine it is run on) next to the Assets and shaders
    it loads, which is the folder to hand out. A copy of it called Dusk.exe, or a shortcut to it with dusk, is Dusk.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- A window and nothing else, no console coming up behind it. A Debug build keeps its console for the log -->
    <OutputType>WinExe</OutputType>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    The native compiler asks Visual Studio where its linker is (vcvarsall.bat), and newer Visual Studios run
    vswhere.exe for that without saying where it is: it is only found if its folder is on the PATH, which it isn't
    outside of a developer prompt. So the folder is put on the PATH of the build before any of that happens.
  -->
  <UsingTask TaskName="AddToPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Directory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string path = System.Environment.GetEnvironmentVariable("PATH") ?? "";
        if (System.IO.Directory.Exists(Directory) && path.IndexOf(Directory, System.StringComparison.OrdinalIgnoreCase) < 0)
            System.Environment.SetEnvironmentVariable("PATH", Directory + ";" + path);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FindVisualStudioLocator" BeforeTargets="SetupOSSpecificProps" Condition="'$(OS)' == 'Windows_NT' and '$(PublishAot)' == 'true'">
    <AddToPath Directory="$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer" />
  </Target>

  <!-- The libraries' .pdb files came along into the folder to hand out, nobody debugs a published Hex -->
  <Target Name="LeaveTheSymbols" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Hex.Shell\Hex.Shell.csproj" />
    <ProjectReference Include="..\Hex.Dawn\Hex.Dawn.csproj" />
    <ProjectReference Include="..\Hex.Dusk\Hex.Dusk.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon\Horizon.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon.HIDL\Horizon.HIDL.csproj" />
  </ItemGroup>

</Project>
