// What Hex opens on when nothing is open, over the canvas of the empty layout it starts with. Gone the moment anything
// is added to that layout or a file is opened. The recent files are put in by the editor, see HexScene.Welcome.
#define layout

let welcome = compositor.panel({
    fill: "both",
    color: vec(0.065, 0.07, 0.092, 1),
});

// Scroll on short windows. The page grows with the window to 1240 wide and sits in the middle of it: a column of 760 at
// the left of a 1920 window left two thirds of it empty. The room over and under the page is spacers scrolled with it
// rather than the scroll's padding, which it clips inside of: scrolled, the page went 48 pixels under the pane's top.
// DawnScene.Welcome sizes the room over it to the window's height.
let welcome_scroll = compositor.scroll({ parent: welcome, fill: "both", padding: vec(56, 0, 32, 0) });
let welcome_body = compositor.stack({ parent: welcome_scroll, spacing: 0 });
let welcome_top = compositor.spacer({ parent: welcome_body, size: vec(0, 48) });
let page = compositor.stack({
    parent: welcome_body,
    anchor: "top",
    pivot: "top",
    size: vec(760, 0),
    spacing: 32,
});
let welcome_bottom = compositor.spacer({ parent: welcome_body, size: vec(0, 32) });

// The icon beside the name, the way an app's welcome window has it
let brand = compositor.stack({
    parent: page,
    anchor: "left",
    pivot: "left",
    spacing: 16,
    direction: "horizontal",
});

let icon = compositor.image({
    parent: brand,
    anchor: "left",
    pivot: "left",
    file: "Assets/hex_icon.png",
    size: vec(72, 72),
});

// The name over what this release is called, the two as one block beside the icon
let wordmark = compositor.stack({
    parent: brand,
    anchor: "left",
    pivot: "left",
    spacing: 2,
});

let title = compositor.label({
    parent: wordmark,
    anchor: "left",
    pivot: "left",
    text: "@welcome.title",
    text_scale: 0.56,
    bold: true,
    align: "left",
});

// Amphetamine in the weight of a heading and 3.1.0 after it, small and dim: the name is what a person says, the number is
// what a bug report needs
let release = compositor.stack({
    parent: wordmark,
    anchor: "left",
    pivot: "left",
    spacing: 8,
    direction: "horizontal",
});

let release_name = compositor.label({
    parent: release,
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "Amphetamine",
    text_scale: 0.19,
    bold: true,
    align: "left",
});

let release_number = compositor.label({
    parent: release,
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "3.1.0",
    text_scale: 0.14,
    dim: true,
    align: "left",
});

let subtitle = compositor.label({
    parent: page,
    anchor: "left",
    pivot: "left",
    text: "@welcome.subtitle",
    text_scale: 0.17,
    wrap: true,
    size: vec(560, 0),
    dim: false,
    align: "left",
});

// What to start with, in one row under the words: Open Folder first and the one primary, the rest quiet beside it.
// DawnScene.Welcome puts New File and New Project in, orders the row for the designer's welcome or the plain one, and
// sizes each to its words. Stacked a line each where the page is narrow
let start = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 8,
    direction: "horizontal",
});

let new_layout = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "new-file",
    label: "@welcome.new_layout",
    style: "button_flat",
    lbl_scale: 0.15,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let open_file = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "go-to-file",
    label: "@welcome.open_file",
    style: "button_flat",
    lbl_scale: 0.15,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let open_folder = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "folder-opened",
    label: "@welcome.open_folder",
    style: "button",
    primary: true,
    lbl_scale: 0.15,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

// Two columns under the row: what's been going on (what's new, recent files, the agents) on the left, and getting Hex
// set up on the right, a row a setting worth knowing with how it is now. One over the other where the page is narrow
let columns = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 40,
    direction: "horizontal",
});

let recent_column = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

// What the release that's running brought, a line each with a button under it that goes to the thing, put in by the
// editor (HexWhatsNew). First in the column so it's seen without scrolling, and away when there's nothing to say.
let news_column = compositor.stack({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    spacing: 6,
});

let news_title = compositor.label({
    parent: news_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.news",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let news = compositor.stack({
    parent: news_column,
    anchor: "left",
    pivot: "left",
    spacing: 8,
});

let news_gap = compositor.spacer({ parent: news_column, size: vec(0, 10) });

let recent_title = compositor.label({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.recent",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

// A button a file that was worked on lately, put in by the editor
let recent = compositor.stack({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    template: "link.hor",
    preview_count: 3,
    spacing: 2,
});

// The agents of this workspace, a new one, the last chat to carry on with and how many want looking at, put in by the
// editor (DawnScene.Welcome FillWelcomeAgents) and kept up as the chats move. A column of their own on a wide page
// (side_column, after Getting started), under the recent files otherwise: DawnScene.Welcome moves them
let agents_gap = compositor.spacer({ parent: recent_column, size: vec(0, 14) });

let agents_title = compositor.label({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.agents",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let agents = compositor.stack({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    spacing: 2,
});

// Getting started: the settings worth knowing about that nobody finds by looking, grouped, each saying how it is now with
// the switch or the button that changes it there and then. Put in by the editor, see DawnScene.Welcome FillGettingStarted
let getting_column = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

let getting_title = compositor.label({
    parent: getting_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.getting_started",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let getting = compositor.stack({
    parent: getting_column,
    anchor: "left",
    pivot: "left",
    spacing: 2,
});

// The third column on a wide page, the agents' (see agents_title)
let side_column = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

// Help, quietly at the foot: the commands with their key, the keys, the HIDL reference, the release notes
let footer = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 4,
    direction: "horizontal",
});

let commands = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "symbol-misc",
    label: "@welcome.commands",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let keys = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "keyboard",
    label: "@welcome.keys",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let language = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "book",
    label: "@welcome.language",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let changes = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "history",
    label: "@welcome.changes",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});
