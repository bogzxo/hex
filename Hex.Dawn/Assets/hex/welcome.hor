// What Hex opens on when nothing is open, over the canvas of the empty layout it starts with. Gone the moment anything
// is added to that layout or a file is opened. The editor fills it in and lays it out, see DawnScene.Welcome.
//
// One thing leads. The first time that's opening a folder (or cloning one), with Getting started under it, a short list
// of what's worth setting up that ticks itself off. Once there's history the files worked on last lead instead, the row
// of what to start with quieter under them.
#define layout

// Its colour is the skin's, put in by DawnScene.MakeWelcome
let welcome = compositor.panel({
    fill: "both",
});

// Scroll on short windows. The page grows with the window to 1080 wide and sits in the middle of it. The room over and
// under the page is spacers scrolled with it rather than the scroll's padding, which it clips inside of. DawnScene.Welcome
// sizes the room over it to the window's height and the room either side to its width
let welcome_scroll = compositor.scroll({ parent: welcome, fill: "both", padding: vec(56, 0, 32, 0) });
let welcome_body = compositor.stack({ parent: welcome_scroll, spacing: 0 });
let welcome_top = compositor.spacer({ parent: welcome_body, size: vec(0, 48) });
let page = compositor.stack({
    parent: welcome_body,
    anchor: "top",
    pivot: "top",
    size: vec(760, 0),
    spacing: 28,
});
let welcome_bottom = compositor.spacer({ parent: welcome_body, size: vec(0, 32) });

// The icon beside the name, the way an app's welcome window has it, and what to do under it
let brand = compositor.stack({
    parent: page,
    anchor: "left",
    pivot: "left",
    spacing: 16,
    direction: "horizontal",
});

let icon = compositor.image({
    parent: brand,
    anchor: "left",
    pivot: "left",
    // The build's own mark, grey in a Debug build (DawnScene.MakeWelcome puts HexIdentity.ICON here)
    file: "Assets/hex_icon.png",
    size: vec(56, 56),
});

// The name over what this release is called, the two as one block beside the icon
let wordmark = compositor.stack({
    parent: brand,
    anchor: "left",
    pivot: "left",
    spacing: 2,
});

let title = compositor.label({
    parent: wordmark,
    anchor: "left",
    pivot: "left",
    text: "@welcome.title",
    text_scale: 0.44,
    bold: true,
    align: "left",
});

// Amphetamine in the weight of a heading and 3.1.0 after it, small and dim: the name is what a person says, the number is
// what a bug report needs
let release = compositor.stack({
    parent: wordmark,
    anchor: "left",
    pivot: "left",
    spacing: 8,
    direction: "horizontal",
});

let release_name = compositor.label({
    parent: release,
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "Amphetamine",
    text_scale: 0.16,
    bold: true,
    align: "left",
});

let release_number = compositor.label({
    parent: release,
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "3.1.0",
    text_scale: 0.13,
    dim: true,
    align: "left",
});

// What to do now, said for the first time or for the times after (DawnScene.Welcome)
let subtitle = compositor.label({
    parent: page,
    anchor: "left",
    pivot: "left",
    text: "@welcome.subtitle",
    text_scale: 0.17,
    wrap: true,
    size: vec(560, 0),
    dim: true,
    align: "left",
});

// The files worked on last, the lead once there are any: a row each with its icon, its name and the folder it's in.
// Away the first time, when there's nothing to show. Put in by the editor
let recent_column = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 6,
});

let recent_title = compositor.label({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.recent",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let recent = compositor.stack({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    template: "link.hor",
    preview_count: 3,
    spacing: 0,
});

// What to start with: Open Folder and Clone Repository, the two that lead the first time, then the quieter ones in a row of
// their own. DawnScene.Welcome puts the rest in, orders them for the designer's welcome or the plain one and sizes each to
// its words, a line each where the page is narrow
let start_block = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 10,
});

let lead = compositor.stack({
    parent: start_block,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 8,
    direction: "horizontal",
});

let open_folder = compositor.button({
    parent: lead,
    anchor: "left",
    pivot: "left",
    icon: "folder-opened",
    label: "@welcome.open_folder",
    style: "button",
    primary: true,
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let clone = compositor.button({
    parent: lead,
    anchor: "left",
    pivot: "left",
    icon: "repo-clone",
    label: "@welcome.clone",
    style: "button",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let start = compositor.stack({
    parent: start_block,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 4,
    direction: "horizontal",
});

let new_layout = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "new-file",
    label: "@welcome.new_layout",
    style: "button_flat",
    lbl_scale: 0.145,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let open_file = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "go-to-file",
    label: "@welcome.open_file",
    style: "button_flat",
    lbl_scale: 0.145,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

// Two columns under it: Getting started, and the agents with what's new. One over the other where the page is narrow
let columns = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 48,
    direction: "horizontal",
});

// Getting started: a short list of what's worth setting up, each ticked off once it is, with how it is now and the switch
// or button that does it there and then. Put in by the editor, see DawnScene.WelcomeChecklist
let getting_column = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

let getting = compositor.stack({
    parent: getting_column,
    anchor: "left",
    pivot: "left",
    spacing: 2,
});

// The agents of this workspace and what the release brought
let side_column = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

// A new agent, the last chat to carry on with and how many want looking at, put in by the editor (DawnScene.Welcome
// FillWelcomeAgents) and kept up as the chats move
let agents_block = compositor.stack({
    parent: side_column,
    anchor: "left",
    pivot: "left",
    spacing: 4,
});

let agents_title = compositor.label({
    parent: agents_block,
    anchor: "left",
    pivot: "left",
    text: "@welcome.agents",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let agents = compositor.stack({
    parent: agents_block,
    anchor: "left",
    pivot: "left",
    spacing: 0,
});

let agents_gap = compositor.spacer({ parent: agents_block, size: vec(0, 18) });

// What the release that's running brought, a line each with a button under it that goes to the thing, put in by the
// editor (HexWhatsNew), and away when there's nothing to say
let news_column = compositor.stack({
    parent: side_column,
    anchor: "left",
    pivot: "left",
    spacing: 6,
});

let news_title = compositor.label({
    parent: news_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.news",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let news = compositor.stack({
    parent: news_column,
    anchor: "left",
    pivot: "left",
    spacing: 8,
});

// Help, quietly at the foot: the commands with their key, the keys, the HIDL reference, the release notes
let footer = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 4,
    direction: "horizontal",
});

let commands = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "symbol-misc",
    label: "@welcome.commands",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let keys = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "keyboard",
    label: "@welcome.keys",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let language = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "book",
    label: "@welcome.language",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let changes = compositor.button({
    parent: footer,
    anchor: "left",
    pivot: "left",
    icon: "history",
    label: "@welcome.changes",
    style: "button_flat",
    lbl_scale: 0.135,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});
