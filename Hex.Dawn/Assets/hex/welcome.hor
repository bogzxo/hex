// What Hex opens on when nothing is open, over the canvas of the empty layout it starts with. Gone the moment anything
// is added to that layout or a file is opened. The recent files are put in by the editor, see HexScene.Welcome.
#define layout

let welcome = compositor.panel({
    fill: "both",
    color: vec(0.065, 0.07, 0.092, 1),
});

// Scroll on short windows. The working column starts at the left where the eye does, it isn't centred, so the page
// reads from the same edge as the code that replaces it.
let welcome_scroll = compositor.scroll({ parent: welcome, fill: "both", padding: vec(56, 48, 32, 32) });
let welcome_body = compositor.stack({ parent: welcome_scroll, spacing: 0 });
let page = compositor.stack({
    parent: welcome_body,
    anchor: "top_left",
    pivot: "top_left",
    size: vec(760, 0),
    spacing: 28,
});

// The icon beside the name, the way an app's welcome window has it
let brand = compositor.stack({
    parent: page,
    anchor: "left",
    pivot: "left",
    spacing: 16,
    direction: "horizontal",
});

let icon = compositor.image({
    parent: brand,
    anchor: "left",
    pivot: "left",
    file: "Assets/hex_icon.png",
    size: vec(56, 56),
});

// The name over what this release is called, the two as one block beside the icon
let wordmark = compositor.stack({
    parent: brand,
    anchor: "left",
    pivot: "left",
    spacing: 2,
});

let title = compositor.label({
    parent: wordmark,
    anchor: "left",
    pivot: "left",
    text: "@welcome.title",
    text_scale: 0.46,
    bold: true,
    align: "left",
});

// Solstice in the weight of a heading and 3.0.0 after it, small and dim: the name is what a person says, the number is
// what a bug report needs
let release = compositor.stack({
    parent: wordmark,
    anchor: "left",
    pivot: "left",
    spacing: 8,
    direction: "horizontal",
});

let release_name = compositor.label({
    parent: release,
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "Solstice",
    text_scale: 0.19,
    bold: true,
    align: "left",
});

let release_number = compositor.label({
    parent: release,
    anchor: "bottom_left",
    pivot: "bottom_left",
    text: "3.0.0",
    text_scale: 0.14,
    dim: true,
    align: "left",
});

let subtitle = compositor.label({
    parent: page,
    anchor: "left",
    pivot: "left",
    text: "@welcome.subtitle",
    text_scale: 0.17,
    wrap: true,
    size: vec(560, 0),
    dim: false,
    align: "left",
});

let columns = compositor.stack({
    parent: page,
    anchor: "top_left",
    pivot: "top_left",
    spacing: 40,
    direction: "horizontal",
});

let start = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

let start_title = compositor.label({
    parent: start,
    anchor: "left",
    pivot: "left",
    text: "@welcome.start",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let new_layout = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "new-file",
    label: "@welcome.new_layout",
    style: "button_flat",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let open_file = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "go-to-file",
    label: "@welcome.open_file",
    style: "button_flat",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let open_folder = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "folder-opened",
    label: "@welcome.open_folder",
    style: "button",
    primary: true,
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let commands = compositor.button({
    parent: start,
    anchor: "left",
    pivot: "left",
    icon: "symbol-misc",
    label: "@welcome.commands",
    style: "button_flat",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let recent_column = compositor.stack({
    parent: columns,
    anchor: "top",
    pivot: "top",
    spacing: 4,
});

// What the release that's running brought, a line each with a button under it that goes to the thing, put in by the
// editor (HexWhatsNew). First in the column so it's seen without scrolling, and away when there's nothing to say.
let news_column = compositor.stack({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    spacing: 6,
});

let news_title = compositor.label({
    parent: news_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.news",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let news = compositor.stack({
    parent: news_column,
    anchor: "left",
    pivot: "left",
    spacing: 8,
});

let news_gap = compositor.spacer({ parent: news_column, size: vec(0, 10) });

let recent_title = compositor.label({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.recent",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

// A button a file that was worked on lately, put in by the editor
let recent = compositor.stack({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    template: "link.hor",
    preview_count: 3,
    spacing: 2,
});

let help_gap = compositor.spacer({ parent: recent_column, size: vec(0, 14) });

let help_title = compositor.label({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    text: "@welcome.help",
    text_scale: 0.17,
    bold: true,
    align: "left",
});

let keys = compositor.button({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    icon: "keyboard",
    label: "@welcome.keys",
    style: "button_flat",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let language = compositor.button({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    icon: "book",
    label: "@welcome.language",
    style: "button_flat",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});

let changes = compositor.button({
    parent: recent_column,
    anchor: "left",
    pivot: "left",
    icon: "history",
    label: "@welcome.changes",
    style: "button_flat",
    lbl_scale: 0.16,
    hover: "none",
    hover_amount: 4,
    hover_time: 0.08,
});
