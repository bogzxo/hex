// The editor of a number between two ends, a slider for getting there quickly and the number for getting there exactly.
#define layout

let row = compositor.stack({ direction: "horizontal", spacing: 4 });

let slider = compositor.slider({
    parent: row,
    size: vec(148, 22),
});

let exact = compositor.number_box({
    parent: row,
    size: vec(68, 28),
    padding: vec(6, 6, 6, 6),
    text_scale: 0.14,
});
