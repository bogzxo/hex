    settings_text: {
        tab_size_title: "Tab size",
        tab_size_help: "How many columns wide a tab is drawn and how deep a level of indentation goes, 1 to 16. A project's .editorconfig wins over it when Use .editorconfig is on, and so does what a file is already indented with when Detect indentation is on.",
        insert_spaces_title: "Insert spaces",
        insert_spaces_help: "Whether Tab and indenting put in spaces rather than a tab. A project's .editorconfig (indent_style) wins over it when Use .editorconfig is on.",
        detect_indentation_title: "Detect indentation",
        detect_indentation_help: "Whether a file that is opened keeps the indentation it already has, tabs or so many spaces, worked out from its first couple of hundred lines. A project's .editorconfig wins over it.",
        line_numbers_title: "Line numbers",
        line_numbers_help: "Whether the lines of code are numbered down the left.",
        indent_guides_title: "Indent guides",
        indent_guides_help: "Whether faint lines are drawn down every level of indentation.",
        editorconfig_title: "Use .editorconfig",
        editorconfig_help: "Whether the .editorconfig files of a project (indent_style, indent_size, tab_width) have the last word on how its files are indented, the way most editors read them. They win over the settings here.",
        rulers_title: "Rulers",
        rulers_help: "The columns a faint line is drawn straight down the code at, to keep lines under, as numbers with commas between them (80, 120). Anything that isn't a column from 1 to 500 is left out, empty for none.",
        rulers_placeholder: "80, 120",
        render_whitespace_title: "Render whitespace",
        render_whitespace_help: "Where the spaces and tabs of the code are drawn, a faint dot for a space and an arrow for a tab.",
        render_whitespace_none: "None",
        render_whitespace_none_help: "They're never drawn, just room between the words.",
        render_whitespace_selection: "Selection",
        render_whitespace_selection_help: "Only inside what's selected, so it shows what you're about to move or delete.",
        render_whitespace_boundary: "Boundary",
        render_whitespace_boundary_help: "The indentation a line starts with and whatever is left trailing at its end, not the single spaces between words.",
        render_whitespace_all: "All",
        render_whitespace_all_help: "Every space and tab there is.",
        cursor_style_title: "Cursor style",
        cursor_style_help: "How the caret is drawn in the code.",
        cursor_style_line: "Line",
        cursor_style_line_help: "A thin line before the character, the way it always was.",
        cursor_style_block: "Block",
        cursor_style_block_help: "A block over the character, the character still written inside it, the way a terminal draws it.",
        cursor_style_underline: "Underline",
        cursor_style_underline_help: "A line under the character.",
        sticky_scroll_title: "Sticky scroll",
        sticky_scroll_help: "Whether the lines the top of the code is inside of (the class, the function) stay held at the top as it scrolls, so you always know where you are.",
        format_on_save_title: "Format on save",
        format_on_save_help: "Whether Ctrl+S has the file's language server format it before it's written. A file with no server that formats is saved as it is, and so is one whose server takes longer than three quarters of a second.",
        files_exclude_title: "Files exclude",
        files_exclude_help: "Globs of files and folders left out everywhere, the explorer, quick open, Find in Files and the watcher. ** is any number of folders, * any part of a name, a slash at the end only folders. VS Code's files.exclude.",
        files_exclude_placeholder: "**/*.log",
        search_exclude_title: "Search exclude",
        search_exclude_help: "Globs left out of quick open, Find in Files and the watcher but still shown in the explorer, what gets built and what package managers fetch. On top of Files exclude. VS Code's search.exclude.",
        search_exclude_placeholder: "**/fixtures",
        search_use_ignore_files_title: "Use .gitignore",
        search_use_ignore_files_help: "Whether quick open, Find in Files and the watcher leave out what each .gitignore says, the one at the top of a folder and the ones in the folders under it. The explorer still shows those files.",
        add_pattern: "Add Pattern",
        status_tabs: "Tab Size: {count}",
        status_tip: "How the file is indented, by the settings, its .editorconfig or how it already was. Click for Editor, Text in the settings"
    },

    settings_catalog: {
        effects_title: "Effects",
        effects_help: "None of them, subtle (the lights switched on under this, and a burst of sparks for a save or a long command that went well when the sparks are on) or all (sparks off the caret as you type as well). The glass and the caret's glide have switches of their own.",
        effect_glass_title: "Glass",
        effect_glass_help: "Whether the dialogs, the menus, the palette and the side panels sit on glass over what is behind them, blurred and bent at the rim.",
        effect_sparks_title: "Sparks",
        effect_sparks_help: "Whether the effects that are on throw sparks, on a save, a long command that went well and as you type.",
        effect_motion_title: "Smooth caret",
        effect_motion_help: "Whether the caret glides to where it goes rather than jumping there.",
        effect_caret_glow_title: "Glow under the caret",
        effect_caret_glow_help: "Whether a soft light follows the caret about as you type, and the cursor in Dusk.",
        effect_spotlight_title: "Spotlight",
        effect_spotlight_help: "Whether a faint light sits under the pointer wherever it goes, the way Windows lit what you were over.",
        effect_ripples_title: "Ripples",
        effect_ripples_help: "Whether a ring spreads out of every click.",
        effect_trail_title: "Pointer trail",
        effect_trail_help: "Whether the pointer leaves a few embers behind it when it is moved quickly.",
        glass_blur_title: "Glass blur",
        glass_blur_help: "How far what is behind the glass is blurred, in pixels, 0 for clear glass. The side panels take a little more.",
        glass_clarity_title: "Glass clarity",
        glass_clarity_help: "How much of what is behind the glass shows through the colour of the panel on it, 0 for none of it, 1 for all of it.",
        glass_rim_title: "Glass rim brightness",
        glass_rim_help: "How bright the silver lining round the edge of the glass is.",
        glass_bend_title: "Glass edge bend",
        glass_bend_help: "How far the rim of the popups' glass bends what is behind it, in pixels. 0 is frosted glass, a blur laid flat. More is liquid glass, what's behind bent hard round the rim and split a little into its colours there, the way Apple's is.",
        ui_animation_title: "Interface animation",
        ui_animation_help: "How quickly the menus, buttons and panels move as they light up, slide open and shut, 1 as they come, 2 twice as quick, 0 for nothing moving at all. Dusk keeps still with its animations off as well.",
        caret_glide_title: "Caret glide time",
        caret_glide_help: "How long the caret takes to glide to where it goes, in seconds, 0 for it jumping there. Smooth caret has to be on, Dusk's cursor has its own in the terminal's settings.",
        backdrop_title: "Behind the code",
        backdrop_help: "Whether a picture is drawn behind the code, in the bottom right corner of the editor.",
        backdrop_terminal_title: "Behind the terminals",
        backdrop_terminal_help: "Whether the same picture is drawn behind Dusk's terminals as well.",
        backdrop_image_title: "Picture",
        backdrop_image_help: "The picture's file, a .png or a .jpg, empty for the one that comes with Hex.",
        backdrop_image_button_0: "Choose...",
        backdrop_image_button_1: "The usual one",
        backdrop_image_placeholder: "Empty for the usual one, or C:/Pictures/backdrop.png",
        backdrop_opacity_title: "Picture opacity",
        backdrop_opacity_help: "How much of the picture shows through what is written over it.",
        backdrop_scale_title: "Picture size behind the code",
        backdrop_scale_help: "How tall the picture is drawn behind the code, as a share of the window's height.",
        backdrop_across_title: "In from the right behind the code",
        backdrop_across_help: "How far the picture behind the code is in from the editor's right edge, as a share of the window's width.",
        backdrop_up_title: "Up from the bottom behind the code",
        backdrop_up_help: "How far the picture behind the code is up from the editor's bottom edge, as a share of the window's height.",
        terminal_backdrop_scale_title: "Picture size behind the terminals",
        terminal_backdrop_scale_help: "How tall the picture is drawn behind Dusk's terminals, as a share of the window's height, its own size and not the code's.",
        terminal_backdrop_across_title: "In from the right behind the terminals",
        terminal_backdrop_across_help: "How far the picture behind the terminals is in from their right edge, as a share of the window's width.",
        terminal_backdrop_up_title: "Up from the bottom behind the terminals",
        terminal_backdrop_up_help: "How far the picture behind the terminals is up from their bottom edge, as a share of the window's height.",
        backdrop_wrap_title: "Code round the picture",
        backdrop_wrap_help: "Whether wrapped code runs round the shape of what is drawn in the picture rather than over it.",
        backdrop_wrap_margin_title: "Margin round the picture",
        backdrop_wrap_margin_help: "How far the code keeps off the shape of the picture, in pixels.",
        wrap_flow_title: "Wrap glide speed",
        wrap_flow_help: "How quickly a word the wrap moves glides to its new place, 0 for snapping there.",
        code_zoom_title: "Code zoom",
        code_zoom_help: "How big the code is written, 1 as it comes. Ctrl and the wheel over the code change it too.",
        code_font_title: "Code font",
        code_font_help: "The font code is written in, any of the fonts that come with Hex.",
        wrap_code_title: "Wrap code",
        wrap_code_help: "Whether a long line of code wraps at the edge of the editor rather than running off it (Alt+Z).",
        git_blame_title: "Inline blame",
        git_blame_help: "Whether the line the caret is on says faintly at its end who last changed it, when, and the commit, from git.",
        minimap_title: "Minimap",
        minimap_help: "Whether the whole of the code is drawn small down the right of the editor, a slider over what you can see to drag.",
        inlay_hints_title: "Inlay hints",
        inlay_hints_help: "Whether the names of the parameters a call passes to are written faintly in among the code, from HIDL and from the language servers that say them.",
        semantic_highlighting_title: "Semantic highlighting",
        semantic_highlighting_help: "Whether names are coloured by what they are, a class, a method, a field, a parameter, ReSharper's way. Asked of the language servers that say it, and worked out by Hex itself for HIDL, and for D while its server doesn't say. A line being typed on goes back to the plain colours until the typing stops.",
        csharp_colors_title: "C# colours",
        git_autofetch_title: "Fetch in the background",
        git_autofetch_help: "Whether the workspace's git repositories are fetched from their remotes every few minutes, so how far behind a branch is shows without asking.",
        git_autofetch_interval_title: "Background fetch interval",
        git_autofetch_interval_help: "How many minutes go between those fetches in the background.",
        git_account_title: "GitHub account",
        git_account_help: "The GitHub username git signs in as. With more than one account in Git Credential Manager it asks which every time git talks to GitHub, this tells it. A username in a repository's remote or its own credential.username still wins, and a fetch in the background never asks at all.",
        git_account_placeholder: "your-github-username",
        git_pull_mode_title: "Pull with",
        git_pull_mode_help: "How Pull and Sync bring the branch up to date. default leaves it to git config, merge makes a merge commit, rebase puts your commits on top of what came, ff_only only pulls when the branch can just move along.",
        git_confirm_sync_title: "Ask before syncing",
        git_confirm_sync_help: "Whether Sync asks first, saying how many commits it pulls and pushes and with which branch.",
        git_smart_commit_title: "Commit with nothing staged",
        git_smart_commit_help: "What Commit does when nothing is staged. ask offers to stage every change first, always stages everything without asking, never commits nothing and says so.",
        git_subject_length_title: "Summary length",
        git_subject_length_help: "How many characters a commit's first line is best kept to, the box under the message warns past it.",
        git_line_length_title: "Longest summary",
        git_line_length_help: "Past how many characters a commit's first line is cut short in logs and on GitHub, the box under the message says so.",
        debugger_path_title: ".NET debugger",
        debugger_path_help: "Where netcoredbg is, for F5 on C#. Empty looks in a netcoredbg folder next to Hex.exe, the settings folder and the PATH.",
        debugger_path_placeholder: "C:/tools/netcoredbg/netcoredbg.exe",
        run_to_terminal_title: "Run in a terminal",
        run_to_terminal_help: "Whether a file run with Ctrl+F5 runs in a terminal of the panel rather than in the output.",
        mcp_server_title: "Agents (MCP server)",
        mcp_server_help: "Whether AI agents like Claude Code can drive this Hex over the Model Context Protocol, look at it, click, type and run commands. Only programs on this machine run by you, with the token in the settings folder, get in. Claude Code connects with claude mcp add hex -- Hex.exe --mcp",
        reopen_last_title: "Reopen the last workspace",
        reopen_last_help: "Whether the workspace and the files that were open come back when Dawn starts.",
        default_terminal_title: "Dusk as the default terminal",
        default_terminal_help_windows: "Whether console programs started from anywhere but a terminal (cmd from the Run box, a script double clicked) open in Dusk, as a tab of the Dusk that's open or a Dusk of their own. Windows Terminal has to be installed, its console host is what passes the console on, but it's Dusk the program shows up in. Where Windows won't start a program registered for one user, Dusk is registered for every user instead, which asks for admin once. Switched off, whatever the default terminal was before is put back.",
        default_terminal_help_linux: "Whether Dusk is the terminal the desktop opens programs in, first in xdg-terminals.list and GNOME's own setting. Switched off, what was there before is put back.",
        default_terminal_failed: "Dusk couldn't be made the default terminal, {why}",
        explorer_menu_title: "Open in Hex in Explorer",
        explorer_menu_help: "Whether right clicking a file, a folder or the inside of a folder in Explorer has Open in Hex, for this Hex.exe and only for you. It's the registry's, not the settings file's, so it shows what Windows has.",
        explorer_menu_verb: "Open in Hex",
        user_path_title: "Hex on the PATH",
        user_path_help: "Whether the folder Hex.exe is in is on your PATH, so hex can be typed in any terminal. Terminals opened after it see it, the ones already open don't. It's the registry's, not the settings file's.",
        trim_whitespace_title: "Trim trailing spaces",
        trim_whitespace_help: "Whether the spaces and tabs at the ends of the lines of a file of code go when it is saved.",
        final_newline_title: "End with a newline",
        final_newline_help: "Whether a file of code is saved with a newline at its end when it hasn't one.",
        auto_save_title: "Auto save",
        auto_save_help: "Whether a file of code is saved by itself a moment after typing in it stops (trailing spaces are left for a save by hand, you might be about to type after them).",
        auto_save_delay_title: "Auto save delay",
        auto_save_delay_help: "How long typing has to have stopped for, in seconds.",
        files_associations_title: "File associations",
        files_associations_help: "Which language a file is opened as by a pattern of its name, *.orig as csharp say, for files whose extension says nothing or the wrong thing. The value is a language id, the ones Change Language Mode (Ctrl+K M) lists.",
        files_associations_key_placeholder: "*.orig",
        files_associations_value_placeholder: "csharp",
        snap_title: "Snap",
        snap_help: "How many pixels the designer snaps what is dragged to, 0 for none.",
        canvas_handles_title: "Handles on the canvas",
        canvas_handles_help: "Whether the designer draws the handles that drag a component bigger."
    },

