// Everything Hex says, in English, by where it says it. Hex's layouts name these with an @, "@toolbar.save", and the code
// asks for the rest by the same keys. Change anything here and Hex shows it the next time it starts (the windows of
// the Help menu read it again every time they open). A text written as a list is its lines, which is how the pages of
// help are written, markdown and all (# a heading, - a bullet, `code`, **bold**, and $(name) for an icon). A name in
// braces, {version}, is filled in by Hex.

let strings = {
    // The window itself, its title bar
    window: {
        title: "Hex"
    },

    // The buttons at the right end of the tabs, and what each says when the pointer rests on it
    toolbar: {
        new_file: "New Layout (Ctrl+N)",
        open_file: "Open File (Ctrl+O)",
        save: "Save (Ctrl+S)",
        save_all: "Save All (Ctrl+Shift+S)",
        undo: "Undo (Ctrl+Z)",
        redo: "Redo (Ctrl+Y)",
        design: "Design",
        design_tip: "Design view, the canvas and the tools for building a layout (F7)",
        code: "Code",
        code_tip: "Code view, the layout as it is written; edits are applied to the designer (F7)",
        play: "Play",
        play_tip: "Play the layout's entrance animations from the start (F5)",
        run: "Run",
        run_tip: "Run the file and list what it declares in the Output panel (F5)",
        table: "Table",
        table_tip: "Table view, an object of objects as rows, or a strings file with its languages side by side (F7)",
        find: "Find in Files (Ctrl+Shift+F)",
        name_placeholder: "layout name",
        name_tip: "The layout's name, which is its file name"
    },

    // The column of icons down the left, which view the side bar shows
    activity: {
        explorer: "Explorer (Ctrl+Shift+E)",
        search: "Search (Ctrl+Shift+F)",
        outline: "Outline (Ctrl+Shift+O)",
        design: "Toolbox, components and layers (Ctrl+Shift+O)",
        debug: "Debug, the stack, the variables and the breakpoints (F5 starts)",
        extensions: "Extensions",
        settings: "Settings (Ctrl+,)"
    },

    // The side bar, its heading for each view and its sections
    side: {
        explorer: "EXPLORER",
        explorer_of: "EXPLORER, {workspace}",
        open_a_layout: "NO LAYOUT OPEN",
        search: "SEARCH",
        outline_of: "OUTLINE, {file}",
        designer: "DESIGNER",
        toolbox: "TOOLBOX",
        layers: "LAYERS"
    },

    // The panel under the editor
    panel: {
        problems: "$(error) PROBLEMS",
        problems_count: "$(error) PROBLEMS  {count}",
        output: "$(output) OUTPUT",
        console: "$(terminal) TERMINAL",
        console_placeholder: "Evaluate HIDL in the current file, e.g. moves.jab or len(keys(strings))",
        console_tip: "Runs in the scope of the current file's last run. Enter evaluates, Up and Down recall history"
    },

    // The runner, a function of the file called tick after tick
    runner: {
        next: "Next tick: {tick}",
        nothing: "Nothing to run. The file has not run yet, or that is not one of its functions",
        over: "Restarted. The file runs again from its initial state, the runner from tick 1"
    },

    // The find bar over the code
    find: {
        none: "No results",
        count: "{count} results",
        of: "{index} of {count}",
        bad_regex: "Invalid regular expression"
    },

    // The console, the third page of the panel
    console: {
        welcome: "HIDL in the file on screen. A line is run in what the file came to, what it declares stays for the lines after it.",
        busy: "The console is still evaluating the previous line"
    },

    // What Hex says is wrong with a file from what it comes to
    lint: {
        typo: "Only {name} has '{key}'; {count} of the {of} siblings have '{meant}'. Possible typo",
        no_file: "File not found: {path} (searched this folder and every folder above it)"
    },

    // A file of code as a table
    table: {
        nothing: "Nothing in this file can be shown as a table (an object of objects, or a strings file)",
        key: "Key",
        missing: "missing",
        missing_in: "No {language} text for this key",
        shown: "{file} as a table. F7 returns to the code, double-click a literal value to edit it"
    },

    // What Hex opens on when nothing is open
    welcome: {
        title: "Hex",
        subtitle: "The IDE for HIDL and Horizon, {version}\nA code-driven WYSIWYG layout editor.",
        start: "Start",
        new_layout: "New Layout",
        open_file: "Open File...",
        open_folder: "Open Folder...",
        commands: "Command Palette (Ctrl+Shift+P)",
        help: "Help",
        keys: "Keyboard Shortcuts",
        language: "HIDL Reference",
        changes: "Release Notes",
        recent: "Recent",
        no_recent: "No recent files"
    },

    // The column on the right
    properties: {
        title: "PROPERTIES",
        file: "VALUES",
        hide: "Hide the Properties panel (Ctrl+Alt+B). View menu restores it"
    },

    // The column on the right for code, what the file comes to when it is run
    values: {
        running: "Running...",
        summary: "{count} declared, ran in {time} ms",
        nothing: "Nothing declared. Top-level declarations in the file appear here",
        too_many: "...and more. Expand fewer items",
        not_hidl: "Not a HIDL file, nothing to run",
        layout: "A layout. Its values are its components, press F7 for the designer",
        copy_path: "Copy Path",
        copy_value: "Copy Value as HIDL",
        in_console: "Evaluate in Console",
        worked_out: "This value is computed. Edit it in the code (double-click a literal value to edit it here)",
        elsewhere: "This value is declared in another file, which is now open",
        behind: "The values are behind the code. Try again in a moment",
        not_a_value: "'{text}' is not a HIDL value, nothing was changed",
        changed: "Changed to {text}. Ctrl+Z reverts"
    },

    // The search view before anything was looked for
    search: {
        hint: "Find in Files (Ctrl+Shift+F) searches every file of the workspace. Find All References (Shift+F12) finds every use of a name",
        find: "Find in Files..."
    },

    // The dialogs that pick one of a list as it is typed into (Ctrl+P, the command palette)
    choose: {
        placeholder: "Type to filter"
    },

    // The settings window, a page each
    settings: {
        title: "Settings",
        on: "On",
        off: "Off",

        tabs: {
            editor: "$(settings-gear) Editor",
            backdrop: "$(file-media) Backdrop",
            designer: "$(layout) Designer",
            files: "$(files) Files",
            extensions: "$(extensions) Extensions"
        },

        editor: {
            heading: [
                "## Editor",
                "The appearance of Hex itself. Its own skin is Flat, in one of its themes."
            ],
            skin: "Skin",
            skin_tip: "The skin Hex itself is drawn in, any skin in any of its themes",
            size: "Scale",
            size_tip: "How large Hex draws itself and the layouts in it",
            code_size: "Code zoom",
            code_size_tip: "The size of code relative to the rest of the editor (Ctrl+= and Ctrl+- in a code view)",
            panels: "Panels",
            panels_tip: "The side bar, Properties, the bottom panel and the layers list, at their current sizes",
            put_back: "Reset Panel Sizes"
        },

        backdrop: {
            heading: [
                "## Backdrop",
                "An image drawn faintly in the bottom-right corner of the code editor, behind the text."
            ],
            shown: "Show backdrop",
            wrap: "Wrap code around it",
            wrap_tip: "With word wrap on (Alt+Z), lines run around what is drawn in the image instead of over it",
            margin: "Margin",
            margin_tip: "How far the wrapped code keeps off what is drawn in the image, in pixels",
            flow: "Flow speed",
            flow_tip: "How quickly words glide to their new line when the wrap moves them, right is quicker, all the way left they snap",
            flow_off: "snaps",
            picture: "Image",
            usual: "Default image",
            choose: "Browse...",
            choose_title: "Choose a backdrop image",
            put_back: "Use Default",
            scale: "Scale",
            scale_tip: "The size of the image relative to its own pixels",
            across: "Left and right",
            across_tip: "Where the image sits across the code editor, 0 against its right edge, past that off the edge",
            up: "Up and down",
            up_tip: "Where the image sits up the code editor, 0 on its bottom edge, below that off the edge",
            opacity: "Opacity",
            opacity_tip: "How visible the image is. Code is always drawn over it"
        },

        designer: {
            heading: [
                "## Designer",
                "How layouts are displayed and edited on the canvas."
            ],
            skin: "Layout skin",
            skin_tip: "The skin layouts are drawn in on the canvas. This is the game's setting, not Hex's own, the same as View, Layout Skin",
            theme: "Theme",
            theme_tip: "The theme of the layout skin",
            snap: "Snap to grid",
            snap_tip: "The grid positions and sizes snap to when dragging on the canvas",
            handles: "Resize handles",
            handles_tip: "Whether the selection on the canvas can be resized by dragging its edges"
        },

        files: {
            heading: [
                "## Files",
                "What Hex opens on start and where it keeps its settings."
            ],
            reopen: "Reopen last layout on start",
            reopen_tip: "Whether Hex starts with the layout that was open last",
            note: "Settings are kept in `hex_settings.hor` next to the executable. The last open workspace is restored on start."
        },

        extensions: {
            page: [
                "## Extensions",
                "HIDL scripts that extend Hex. Each is a folder containing an `extension.hor`. Built-in extensions live in `Assets/hex/extensions`; your own go in an `extensions` folder next to the executable. An extension starts as soon as it is enabled and is stopped when disabled."
            ]
        }
    },

    // Extensions, said about in the output and on their page of the settings
    extensions: {
        failed: "Extension '{name}' failed and has been stopped: {why}",
        a_path: "A path, absolute or relative to the extension's folder",
        none: "No extensions found. Add a folder containing an extension.hor to the extensions folder next to Hex",
        by: "by {author}",
        built_in: "Built in",
        own: "User extension",
        open: "Extensions"
    },

    // The windows of the Help menu
    changelog: {
        title: "Release Notes",
        page: [
            "# Release Notes",
            "Newest first. This is Hex {version}.",
            "",
            "## 0.2.5",
            "- Hex's own UI is split into parts under `Assets/hex/shell`, composed with `compositor.include`, a new engine feature any layout can use",
            "- Keyboard Shortcuts (Help menu) lists every command, filters as you type, and rebinds keys; changes are kept in `keys.hor`",
            "- The command palette, Go to File and every chooser can be navigated with the arrow keys",
            "- Menus and messages rewritten in standard IDE English",
            "- Multiple cursors (Ctrl+D, Ctrl+Alt+Up/Down, Ctrl+Shift+L, Alt+click), code folding, sticky scroll, word wrap, signature help and inline hints in the code editor",
            "- A find bar in the editor with match case, whole word, regex, replace and replace all; Find in Files has the same options",
            "- Files changed on disk are detected and reloaded; unsaved text is backed up and restored after a crash",
            "- Go Back and Forward (Alt+Left/Right), Zen Mode (F11), Split Editor (Ctrl+\\), focus line, middle-click to close a tab",
            "- Inline values, likely-fix hints on errors, and a Runner (Ctrl+F5) that calls a function tick by tick",
            "- Extensions can show menus, ask questions and prompt for text, bind commands to keys, hear `on_change`, and reload without restarting Hex",
            "- A backdrop image behind the code, configurable in Settings",
            "- The move editor, the hitbox editor grown into every key of a move, its phases on a timeline, hitboxes, frame data and inputs, written to the files as you go",
            "- Fighter2D started with --content reloads whatever Hex saves, no pause menu needed. The old standalone hitbox editor is gone",
            "- Extensions can edit a file by its values (set, rename or remove a key) with the rest of the file left as written",
            "- Extensions have settings of their own, a tab each in Settings, and can hide Hex's side panels when their view does not need them",
            "- The Properties panel resizes and collapses to the right like the side bar (Ctrl+Alt+B)",
            "- Panels slide in and out, and buttons respond to the pointer",
            "- A layout declares which layers start hidden, and layers hidden in the designer are saved. Hex's own views are layers, so every one of them can be edited in Hex",
            "- Double-click selects a word; drag to extend the selection word by word",
            "- Open Folder uses the system dialog",
            "- The version is shown in the title bar",
            "- Opening a file is 60 ms faster, selection in the designer is three times faster, and the move editor costs nothing when idle",
            "- Syntax colouring waits until typing pauses, so large files no longer stutter",
            "- Undo keeps only the lines it needs rather than a copy of the whole file per step",
            "- HEX_PROFILE reports where each tick's time and allocations go",
            "- The self test runs in parts: --selftest code (or layout, workspace, extensions, garbage)",
            "- Scroll bars stay under the pointer, the table's is clear of the drag handle, and tab titles no longer glitch in a small window",
            "- Hello Dolly says Goodbye, Dolly! now :(",
            "",
            "## 0.2.0",
            "- The Values panel shows what a code file evaluates to, updated as you type; click a value to go to its declaration",
            "- Runtime errors are underlined where they occur, and the comment above a key is its tooltip",
            "- The HIDL console in the bottom panel evaluates a line in the current file's scope",
            "- Extensions, HIDL scripts that drive Hex, enabled and disabled in Settings. Hello Dolly is the first",
            "- The Outline, Explorer and Search views are trees with guides and icons",
            "- The Explorer reads a folder once and watches it; F8 and Find in Files no longer freeze Hex",
            "- Notification cards for messages the status bar cannot hold, and a welcome page when nothing is open",
            "- Bottom panel tabs are readable",
            "- HIDL gains ?? and ?., template strings, merge, and errors that report their line",
            "- A moves or characters file can be shown as a table (F7), and a strings file with its languages side by side",
            "- Literal values can be edited in place in Values or the table and are written back into the code",
            "- A key that only one move has and that is a letter off the others is flagged, as is a path to a missing file",
            "- Every error in a file is underlined, not only the first",
            "- The toolbar under the menus is gone; a file's actions sit at the right end of its tabs",
            "",
            "## 0.1.0",
            "- Closing asks once about unsaved files and can be answered",
            "- A click on Settings (or any floating window) over the canvas stays in the window",
            "- Hex publishes as a native executable with no .NET dependency",
            "- Panel resize handles are where the pointer grabs them",
            "- The layers list and the bottom panel stop growing at the window edge, and the status bar stays visible",
            "- A group, or any container, can be converted to another container kind from its context menu",
            "- All of Hex's text is in its own strings file (Assets/hex/localisation/en-gb.hor), these release notes included",
            "- Help pages wrap to their window when resized",
            "- Hex draws only when something changes, ticks a few times a second when idle, and waits on system events",
            "- Near-zero garbage; Output and Problems rows are built on demand",
            "- Hex can use any skin",
            "- The layout skin's theme has its own setting",
            "- A greeting in the title bar",
            "",
            "## 0.0.9",
            "- A custom title bar with the menus in it; drag to move the window, double-click to maximise",
            "- Settings in a floating window with tabs: Editor, Designer, Files and Extensions",
            "- Every part of Hex's own UI is a layout file you can open in Hex",
            "- Larger text throughout, and a separate zoom for code (Ctrl+= and Ctrl+-, Ctrl and the wheel)",
            "- Property editors get more room and their names less",
            "",
            "## 0.0.8",
            "- VS Code style layout: an activity bar, a side bar of views, tabs with a modified dot, breadcrumbs, Problems and Output panels, a status bar",
            "- Icons throughout, VS Code's own Codicons",
            "- Context-sensitive menus, submenus, and Ctrl+Shift+P for the command palette",
            "- Context menus for the code, the canvas, the tree, the tabs and the problems",
            "- Semantic colouring, bracket colouring by depth, hover hints",
            "- Colour swatches in the code, click for a picker, and F2 to rename a symbol throughout a file",
            "",
            "## 0.0.7",
            "- `#define layout` marks a file as a layout; the designer and the code of a layout are separate views (F7)",
            "- Every tab has a close button, and closing with unsaved changes asks first",
            "- HIDL has a preprocessor: #define, #if and the rest",
            "",
            "## 0.0.6",
            "- Multi-folder workspaces with an Explorer, saved as .hex-workspace files",
            "- Completion as you type, F12 to go to a declaration, Shift+F12 to find all references",
            "",
            "## 0.0.5",
            "- Hex edits every .hor file, not only layouts, with find, replace and go to line",
            "- Ctrl+P opens any file by a few letters, Ctrl+Shift+F finds in files, F8 checks all files, F5 runs one",
            "",
            "## 0.0.4",
            "- Hex has a repository of its own, with the engine as a submodule",
            "",
            "## 0.0.3",
            "- Layouts reference the game's strings by key (@main_menu.quit) and display them in the game's language",
            "- Labels support bold, italic, colours, sizes and markdown",
            "",
            "## 0.0.2",
            "- Collapsible property sections, and hover effects on components",
            "- Tab into a text box selects its contents; the tree scrolls to the selection",
            "",
            "## 0.0.1",
            "- The layout editor: a canvas that draws layouts as a game does, a palette, a tree, properties, generated code, undo, layers, templates, and a self test that clicks through it all"
        ]
    },

    keys: {
        title: "Keyboard Shortcuts",
        filter: "Type to filter commands",
        hint: "Enter sets a new key, Delete removes it",
        reset: "Reset All",
        reset_tip: "Restore every shortcut to its default",
        press_title: "Shortcut for {command}",
        press_text: "Press the new key, with Ctrl, Shift or Alt as required. Currently {key}. Esc cancels.",
        no_key: "Unassigned",
        leave_it: "Cancel",
        now: "{command} is now {key}",
        now_instead: "{command} is now {key}. {other} is unassigned",
        removed: "{command} is unassigned",
        back: "Keyboard shortcuts reset to defaults",
        back_already: "Keyboard shortcuts are already the defaults",
        fixed_tip: "Built into the editor and cannot be changed",

        // The keys that aren't a command of a menu, a key in backticks, two spaces, what it does
        fixed: [
            "- `Ctrl+Space`  Trigger completion",
            "- `Tab`, `Shift+Tab`  Indent and outdent the selection",
            "- `Ctrl+Up`, `Ctrl+Down`, `Ctrl+Left`, `Ctrl+Right`  Move the selection in the layout tree",
            "- `Arrow keys`  Nudge the selection on the canvas by one pixel",
            "- `Mouse wheel`  Zoom the canvas; middle button or Space pans it",
            "- `Ctrl+Mouse wheel`  Zoom the code",
            "- `Alt+Click`  Add a cursor",
            "- `F2`  Rename the selected Explorer item"
        ]
    },

    language: {
        title: "HIDL Reference",
        page: [
            "# HIDL",
            "The interpreted language every .hor file is written in: layouts, data, strings and skins.",
            "",
            "## Values",
            "- Numbers `3`, `0.5`; strings `\"fight\"`; `true`, `false`, `null`",
            "- Vectors `vec(1, 2)`, `vec(0.2, 0.4, 0.9, 1)` for a colour",
            "- Objects `{ name: \"Ryu\", health: 100 }`, lists `[1, 2, 3]`",
            "",
            "## Code",
            "```",
            "let speed = 3;",
            "const name = \"fight\";",
            "func add(a, b) { return a + b; }",
            "if (speed > 2) { print(\"fast\"); } else { print(\"slow\"); }",
            "for (item in [1, 2, 3]) { print(item); }",
            "let other = include(\"other.hor\");",
            "```",
            "",
            "## Directives",
            "A line starting with # is processed before the rest. `#define layout` marks the file as a layout, which Hex opens in the designer. Also `#define name value`, `#if defined(name)`, `#ifdef`, `#ifndef`, `#elif`, `#else`, `#endif`; code can query `defined(\"name\")` and `definition(\"name\")`.",
            "",
            "## Layouts",
            "```",
            "#define layout",
            "let panel = compositor.stack({ spacing: 8 });",
            "let title = compositor.label({ parent: panel, text: \"@main_menu.title\" });",
            "let hud = compositor.include({ parent: panel, file: \"hud.hor\" });",
            "```",
            "A string starting with @ is a key of the game's strings. A label reads `[b]`, `[i]`, `[color:red]`, `$(save)` for an icon, and markdown when `markdown: true`. `compositor.include` builds another layout file inside a component; its parts are found by name as if written in the including file.",
            "",
            "## Strings files",
            "`let strings = { ... }`, a string per key, nested objects for dotted keys, and a list of strings for a multi-line text.",
            "",
            "## Library",
            "`print`, `include`, `keys`, `values`, `has`, `range`, `len`, `text`, `number`, `format`, `typeof`, `error`, `math` and `defined`. Hover any of them in the editor for details."
        ]
    },

    about: {
        title: "About Hex",
        page: [
            "# Hex {version}",
            "The layout editor for Horizon and the IDE for HIDL, rendered by Horizon's own UI on Vulkan.",
            "",
            "Horizon {engine}, .NET {dotnet}",
            "",
            "## Licences",
            "Icons are **Codicons**, the icons of Visual Studio Code, Copyright (c) Microsoft Corporation, under the Creative Commons Attribution 4.0 International licence (Assets/fonts/codicons in the engine).",
            "",
            "Cascadia Mono is under the SIL Open Font License."
        ]
    }
