// The art of the phase picked on the timeline, every frame of its animation in a row, the ones it plays lit, the one it
// starts on marked, and the one drawn on the game frame on screen underlined. A click on a frame starts the phase there
// (start), for a phase that has an animation of its own.

let edits = include("edits.hor");

let HEIGHT = 52;

// The animation the picked phase plays, its own or the one it carries on, and whether it's its own
func animation_of(state) {
    if (state.move == null || state.phase == null) { return null; }
    let written = state.moves[state.move].move.phases[state.phase];
    if (written == null) { return null; }

    for (phase in state.laid.phases) {
        if (phase.name == state.phase) { return { name: phase.animation, own: written.animation != null, start: written.start ?? 0 }; }
    }
    return null;
}

// Where the frames go, { left, size, count }
func geometry(state, count) {
    let width = state.ui.get("strip").view_size.x;
    let size = math.min(HEIGHT, math.max(8, (width - 16) / math.max(1, count)));
    return { left: -size * count / 2, size: size, count: count };
}

func draw(state) {
    let strip = state.ui.get("strip");
    strip.clear();
    let animation = animation_of(state);
    if (animation == null || state.art == null || !state.art.has(animation.name)) { return; }

    let at = geometry(state, state.art.frames(animation.name));
    let on_screen = shown_now(state, animation.name);
    for (i in range(at.count)) {
        let x0 = at.left + i * at.size;
        let lit = i >= animation.start;
        strip.sprite(state.art, animation.name, i, vec(x0, -at.size / 2), vec(x0 + at.size - 2, at.size / 2), vec(1, 1, 1, lit ? 1 : 0.3));
        if (i == animation.start) { strip.frame(vec(x0 - 1, -at.size / 2 - 1), vec(x0 + at.size - 1, at.size / 2 + 1), 2, vec(0.95, 0.75, 0.3, 1)); }
        if (i == on_screen) { strip.rect(vec(x0, -at.size / 2 - 4), vec(x0 + at.size - 2, -at.size / 2 - 2), vec(1, 1, 1, 0.9)); }
    }

    let own = animation.own ? "" : ", carried on from the phase before";
    strip.text(`{animation.name}{own}`, vec(at.left, at.size / 2 + 2), 0.09, vec(1, 1, 1, 0.6));
}

// The art frame the game frame on screen draws, when it's of this animation, -1 otherwise
func shown_now(state, animation) {
    if (len(state.laid.frames) == 0) { return -1; }
    let frame = state.laid.frames[math.clamp(state.frame, 0, len(state.laid.frames) - 1)];
    return frame.animation == animation ? frame.shown : -1;
}

func pointer(state, e) {
    if (e.kind != "down") { return; }
    let animation = animation_of(state);
    if (animation == null || state.art == null || !state.art.has(animation.name)) { return; }
    if (!animation.own) {
        state.warn(`{state.phase} carries on the art of the phase before, give it an animation of its own to start it somewhere`);
        return;
    }

    let at = geometry(state, state.art.frames(animation.name));
    let frame = math.floor((e.at.x - at.left) / at.size);
    if (frame < 0 || frame >= at.count || frame == animation.start) { return; }

    if (frame == 0) {
        edits.clear_phase_key(state, state.move, state.phase, "start");
    } else {
        edits.set_phase_key(state, state.move, state.phase, "start", frame);
    }
}
