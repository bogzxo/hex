// view_button, laid out with Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
// The button of a view an extension made for a file, at the end of the tabs next to Code and Table.
#define layout

let view_button = compositor.button({
    size: vec(0, 28),
    hover: "lift",
    hover_amount: 1.5,
    hover_time: 0.08,
    label: "View",
    icon: "extensions",
    lbl_scale: 0.14,
    style: "button_flat",
    animated: false,
});
