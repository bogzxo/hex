// The language servers Hex lints and completes other languages with, the protocol VS Code gets its squiggles through.
// One entry a server, the command it is started with (on the PATH, or a full path), its arguments, the language id the
// protocol knows the files by and the files it is for. A server that isn't on the machine is said once a session, with
// how it is installed, and the file is coloured all the same. HIDL isn't in here, Hex is its server, the editor knows a
// file of it inside, and `Hex --lsp` is the same knowledge for any other editor.
//
// What the settings (Editor, Language servers) make of the rest of an entry, all of it optional:
//   about    a sentence on what it is, said under its name with how it is installed
//   install  the command line that installs it, run by the usual shell when Install is pressed (empty for a server
//            that is downloaded by hand, Install opens its releases instead). One for every system, or an object of
//            them by windows, macos and linux when they differ (a system it doesn't name is downloaded by hand)
//   update   the command line that updates it, the install one when it doesn't say, by system as install can be
//   repo     its repository on GitHub, owner/name, where new versions and what changed in them are looked up
//   version  the arguments that make it say its version, left out for a server that has no way to
//   reload   the files that have it started again when they're made, changed or taken away in the workspace, for a
//            server that reads its projects once as it starts and never again (csharp-ls doesn't load a project that
//            comes after it), by name or *.extension
//   settings what it's told to be, by its sections the way VS Code's settings have them, said as it starts and
//            whenever it asks (serve-d only says what's wrong with a file outside a dub project as it's opened when
//            told d.lintOnFileOpen is "always"). {root} in a text is the folder the server runs in, serve-d completes
//            the modules of a lone file's folder once it's one of its d.projectImportPaths
//
// {solution} in an argument is the solution in the folder the server runs in, the one named after the folder or the
// first, and where there's none the argument goes with the flag in front of it. csharp-ls looked for solutions all the
// way down and loaded the engine's in Fighter2D's external folder instead of Fighter2D's own.
//
// Where a server is can be set in the settings as well, which wins over the command here. ruff lints Python quicker than
// pyright, swap the python entry for it if you'd rather (`pip install ruff`, command "ruff", args ["server"]).
let servers = {
    csharp: {
        command: "csharp-ls", args: ["--solution", "{solution}"], language: "csharp", extensions: [".cs"],
        about: "C#, on Roslyn. Needs a .NET SDK of the same major version as the runtime it runs on.",
        install: "dotnet tool install -g csharp-ls", update: "dotnet tool update -g csharp-ls",
        repo: "razzmatazz/csharp-language-server", version: ["--version"],
        reload: ["*.csproj", "*.sln", "*.slnx", "Directory.Build.props", "Directory.Packages.props", "global.json"]
    },
    python: {
        command: "pyright-langserver", args: ["--stdio"], language: "python", extensions: [".py"],
        about: "Python, Microsoft's type checker. Comes with pyright from npm or pip.",
        install: "npm install -g pyright", update: "npm install -g pyright@latest",
        repo: "microsoft/pyright"
    },
    slang: {
        command: "slangd", args: [], language: "slang", extensions: [".slang"],
        about: "Slang shaders. Comes with the Slang SDK, unpacked somewhere and its bin folder on the PATH or set here.",
        repo: "shader-slang/slang"
    },
    cpp: {
        command: "clangd", args: [], language: "cpp", extensions: [".c", ".h", ".cpp", ".hpp", ".cc"],
        about: "C and C++. Comes with LLVM (Homebrew's is keg-only, set where it is: /opt/homebrew/opt/llvm/bin/clangd), or on its own from clangd's releases. On Linux it's the distribution's clangd package.",
        install: {
            windows: "winget install --id LLVM.LLVM -e --accept-source-agreements --accept-package-agreements",
            macos: "brew install llvm"
        },
        update: {
            windows: "winget upgrade --id LLVM.LLVM -e --accept-source-agreements --accept-package-agreements",
            macos: "brew upgrade llvm"
        },
        repo: "clangd/clangd", version: ["--version"]
    },
    typescript: {
        command: "typescript-language-server", args: ["--stdio"], language: "typescript", extensions: [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"],
        about: "TypeScript and JavaScript, over the TypeScript compiler, which is installed with it.",
        install: "npm install -g typescript-language-server typescript", update: "npm install -g typescript-language-server@latest typescript@latest",
        repo: "typescript-language-server/typescript-language-server", version: ["--version"]
    },
    json: {
        command: "vscode-json-language-server", args: ["--stdio"], language: "json", extensions: [".json"],
        about: "JSON, VS Code's own, with the schemas a file names. One of the servers in vscode-langservers-extracted.",
        install: "npm install -g vscode-langservers-extracted", update: "npm install -g vscode-langservers-extracted@latest",
        repo: "hrsh7th/vscode-langservers-extracted"
    },
    markdown: {
        command: "marksman", args: ["server"], language: "markdown", extensions: [".md"],
        about: "Markdown, links and headings. One program, downloaded from its releases and put on the PATH or set here.",
        repo: "artempyanykh/marksman", version: ["--version"]
    },
    d: {
        command: "serve-d", args: [], language: "d", extensions: [".d", ".di"],
        about: "D, the server code-d is built on, over DCD and D-Scanner. One program, downloaded from its releases (or built with dub) and put on the PATH or set here. It asks to download DCD the first time it starts, which is what it completes with, and finds the standard library through a D compiler on the PATH (dmd or ldc2).",
        repo: "Pure-D/serve-d", version: ["--version"],
        reload: ["dub.json", "dub.sdl"],
        settings: { d: { lintOnFileOpen: "always", projectImportPaths: ["{root}"] } }
    },
    yaml: {
        command: "yaml-language-server", args: ["--stdio"], language: "yaml", extensions: [".yaml", ".yml"],
        about: "YAML, Red Hat's, with schemas by the file's name. It has no releases on GitHub, npm is where its versions are.",
        install: "npm install -g yaml-language-server", update: "npm install -g yaml-language-server@latest"
    },
    go: {
        command: "gopls", args: [], language: "go", extensions: [".go"],
        about: "Go, the Go team's own. Installed with the go tool, into the bin folder of GOPATH (put that on the PATH or set where it is here).",
        install: "go install golang.org/x/tools/gopls@latest",
        version: ["version"],
        reload: ["go.mod", "go.work"]
    },
    rust: {
        command: "rust-analyzer", args: [], language: "rust", extensions: [".rs"],
        about: "Rust, rust-analyzer, with cargo for the project. Comes with rustup as a component of the toolchain.",
        install: "rustup component add rust-analyzer", update: "rustup update",
        version: ["--version"],
        reload: ["Cargo.toml"]
    },
    bash: {
        command: "bash-language-server", args: ["start"], language: "shellscript", extensions: [".sh", ".bash"],
        about: "Bash and other shell scripts, with ShellCheck's findings when shellcheck is on the PATH as well.",
        install: "npm install -g bash-language-server", update: "npm install -g bash-language-server@latest",
        repo: "bash-lsp/bash-language-server", version: ["--version"]
    },
    toml: {
        command: "taplo", args: ["lsp", "stdio"], language: "toml", extensions: [".toml"],
        about: "TOML, Cargo.toml and pyproject.toml among them, with schemas by the file's name. Taplo's command line built with its server.",
        install: "cargo install taplo-cli --locked --features lsp", update: "cargo install taplo-cli --locked --features lsp --force",
        repo: "tamasfe/taplo", version: ["--version"]
    },
    docker: {
        command: "docker-langserver", args: ["--stdio"], language: "dockerfile", extensions: [".dockerfile", ".containerfile"],
        about: "Dockerfiles and Containerfiles, whatever they're called, by their colouring. Comes from npm.",
        install: "npm install -g dockerfile-language-server-nodejs", update: "npm install -g dockerfile-language-server-nodejs@latest",
        repo: "rcjsuen/dockerfile-language-server-nodejs"
    },
    svelte: {
        command: "svelteserver", args: ["--stdio"], language: "svelte", extensions: [".svelte"],
        about: "Svelte components, the script, the styles and the markup. Comes from npm as svelte-language-server.",
        install: "npm install -g svelte-language-server", update: "npm install -g svelte-language-server@latest"
    }
};
