// editor_tabs, laid out with Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout

let tabs_head = compositor.stack({
    anchor: "left",
    pivot: "left",
    spacing: 0,
});

let tab_row = compositor.stack({
    parent: tabs_head,
    size: vec(0, 24),
    anchor: "left",
    pivot: "left",
    spacing: 0,
    direction: "horizontal",
});

let doc_tabs = compositor.tab_strip({ parent: tab_row, size: vec(500, 0) });

let toolbar = compositor.stack({
    parent: tab_row,
    anchor: "right",
    pivot: "right",
    padding: vec(6, 2, 6, 2),
    spacing: 2,
    direction: "horizontal",
});

let views = compositor.stack({
    parent: toolbar,
    anchor: "left",
    pivot: "left",
    spacing: 2,
    direction: "horizontal",
});

let design_view = compositor.button({
    parent: views,
    size: vec(0, 28),
    tooltip: "@toolbar.design_tip",
    hover: "lift",
    hover_amount: 1.5,
    hover_time: 0.08,
    label: "@toolbar.design",
    icon: "layout",
    lbl_scale: 0.14,
    style: "button_flat",
    animated: false,
});

let code_view = compositor.button({
    parent: views,
    size: vec(0, 28),
    tooltip: "@toolbar.code_tip",
    hover: "lift",
    hover_amount: 1.5,
    hover_time: 0.08,
    label: "@toolbar.code",
    icon: "code",
    lbl_scale: 0.14,
    style: "button_flat",
    animated: false,
});

let table_view = compositor.button({
    parent: views,
    size: vec(0, 28),
    tooltip: "@toolbar.table_tip",
    hover: "lift",
    hover_amount: 1.5,
    hover_time: 0.08,
    label: "@toolbar.table",
    icon: "table",
    lbl_scale: 0.14,
    style: "button_flat",
    animated: false,
});

let tools_rule3 = compositor.divider({
    parent: toolbar,
    size: vec(1, 20),
    direction: "vertical",
});

let play_button = compositor.button({
    parent: toolbar,
    size: vec(0, 28),
    tooltip: "@toolbar.run_tip",
    hover: "lift",
    hover_amount: 1.5,
    hover_time: 0.08,
    label: "@toolbar.run",
    icon: "play",
    lbl_scale: 0.14,
    style: "button_flat",
    animated: false,
});

let name_box = compositor.textbox({
    parent: toolbar,
    size: vec(160, 24),
    tooltip: "@toolbar.name_tip",
    padding: vec(8, 5, 8, 5),
    placeholder: "@toolbar.name_placeholder",
    text_scale: 0.14,
    max_length: 40,
});

let crumbs = compositor.breadcrumbs({
    parent: tabs_head,
    size: vec(840, 0),
    padding: vec(6, 0, 6, 0),
});
