// activity_bar, laid out with Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
// The activity bar down the left of Hex, which of the side bar's views is showing. Included by editor.hor.
#define layout

let activity = compositor.stack({
    anchor: "top",
    pivot: "top",
    padding: vec(4, 4, 4, 4),
    spacing: 4,
});

let act_explorer = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.explorer",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "files",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

let act_search = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.search",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "search",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

let act_git = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.git",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "source-control",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

let act_outline = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.outline",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "list-tree",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

let act_design = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.design",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "layout",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

let act_debug = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.debug",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "debug-alt",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

let act_extensions = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.extensions",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "extensions",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});

// Settings at the bottom of the bar, the editor sizes this to push it there
let activity_gap = compositor.spacer({ parent: activity, size: vec(38, 0) });

let act_settings = compositor.button({
    parent: activity,
    size: vec(38, 38),
    tooltip: "@activity.settings",
    hover: "grow",
    hover_amount: 0.1,
    hover_time: 0.08,
    icon: "settings-gear",
    lbl_scale: 0.2,
    style: "button_flat",
    indicator: "left",
    animated: false,
});
