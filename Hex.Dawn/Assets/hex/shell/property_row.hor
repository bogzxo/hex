// property_row, laid out with Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout

let row = compositor.stack({
    anchor: "left",
    pivot: "left",
    spacing: 6,
    direction: "horizontal",
});

let caption = compositor.label({
    parent: row,
    size: vec(128, 0),
    text: "property",
    text_scale: 0.14,
    dim: true,
    wrap: true,
    align: "left",
});

let editor = compositor.stack({
    parent: row,
    spacing: 4,
    direction: "horizontal",
});
