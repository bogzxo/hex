// hint, laid out with Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
// A line of what there is to know where a list has nothing in it yet, "nothing yet, add something". At the left where
// the rows' text starts and in the dim the side bar's notes are in, the one way every empty list of the side says so.
#define layout

let hint = compositor.label({
    anchor: "top",
    pivot: "top",
    fill: "horizontal",
    text: "nothing yet",
    text_scale: 0.14,
    dim: true,
    wrap: true,
    align: "top_left",
});
