<?xml version="1.0" encoding="utf-8"?>
<!--
  Hex's icon behind the H, the same orange as Hex.Shell/Assets/hex_icon.png (the exe's and the windows' icon), the
  lighter top and the darker horizon curving under it. Traced from that picture onto the 108 dp canvas of an adaptive
  icon, its 72 dp middle being the square the picture fills, and drawn past it to the canvas's edge so whatever shape
  the launcher cuts it to (Samsung's squircle, a circle) is all orange. A vector so it's sharp at every density, the
  picture is only 160 pixels.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path android:fillColor="#FF9100" android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
  <path android:fillColor="#FF6700" android:pathData="M0,64 A133.4,133.4 0 0,1 108,64 L108,108 L0,108 Z" />
</vector>
