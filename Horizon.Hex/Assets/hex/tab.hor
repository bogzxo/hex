// One tab over the middle, there is one for every file that is open, and a little x that closes it.
#define layout

let tab_row = compositor.stack({ direction: "horizontal", spacing: 0 });

let tab = compositor.button({
    parent: tab_row,
    label: "layout",
    style: "button_flat",
    size: vec(0, 30),
    lbl_scale: 0.125,
    animated: false
});

let close = compositor.button({
    parent: tab_row,
    label: "x",
    style: "button_flat",
    size: vec(24, 30),
    lbl_scale: 0.125,
    animated: false,
    tooltip: "closes it, asking first if it has changes that aren't saved (Ctrl+W)"
});
