// settings, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
#define layout


let window = compositor.window({
    size: vec(700, 480),
    z: 10,
    padding: vec(8, 8, 8, 8),
    intro: "pop",
    intro_time: 0.18,
    min_size: vec(520, 320),
    title: "@settings.title",
    icon: "settings-gear"
});

let pages = compositor.tabs({
    parent: window,
    size: vec(0, 438),
    fill: "both",
    tabs: [
    "@settings.tabs.editor",
    "@settings.tabs.backdrop",
    "@settings.tabs.designer",
    "@settings.tabs.files",
    "@settings.tabs.extensions"
],
    selected: 4,
    text_scale: 0.14,
    spacing: 22,
    template: "extension_tab.hor"
});

let editor_page = compositor.stack({
    parent: pages,
    fill: "both",
    padding: vec(14, 16, 14, 8),
    spacing: 10
});

let editor_heading = compositor.label({
    parent: editor_page,
    size: vec(620, 0),
    anchor: "left",
    pivot: "left",
    text: "@settings.editor.heading",
    text_scale: 0.14,
    wrap: true,
    markdown: true,
    align: "top_left"
});

let theme_row = compositor.stack({
    parent: editor_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let theme_name = compositor.label({
    parent: theme_row,
    size: vec(210, 28),
    tooltip: "@settings.editor.skin_tip",
    text: "@settings.editor.skin",
    text_scale: 0.14,
    align: "left"
});

let theme = compositor.dropdown({
    parent: theme_row,
    size: vec(260, 28),
    text_scale: 0.14,
    max_rows: 12
});

let size_row = compositor.stack({
    parent: editor_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let size_name = compositor.label({
    parent: size_row,
    size: vec(210, 28),
    tooltip: "@settings.editor.size_tip",
    text: "@settings.editor.size",
    text_scale: 0.14,
    align: "left"
});

let size = compositor.selector({
    parent: size_row,
    size: vec(260, 28),
    text_scale: 0.14
});

let code_zoom_row = compositor.stack({
    parent: editor_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let code_zoom_name = compositor.label({
    parent: code_zoom_row,
    size: vec(210, 28),
    tooltip: "@settings.editor.code_size_tip",
    text: "@settings.editor.code_size",
    text_scale: 0.14,
    align: "left"
});

let code_zoom = compositor.selector({
    parent: code_zoom_row,
    size: vec(260, 28),
    text_scale: 0.14
});

let panels_row = compositor.stack({
    parent: editor_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let panels_name = compositor.label({
    parent: panels_row,
    size: vec(210, 28),
    tooltip: "@settings.editor.panels_tip",
    text: "@settings.editor.panels",
    text_scale: 0.14,
    align: "left"
});

let panels = compositor.button({
    parent: panels_row,
    size: vec(260, 28),
    label: "@settings.editor.put_back",
    icon: "discard",
    lbl_scale: 0.14
});

let backdrop_page = compositor.stack({
    parent: pages,
    fill: "both",
    padding: vec(14, 16, 14, 8),
    spacing: 10
});

let backdrop_heading = compositor.label({
    parent: backdrop_page,
    size: vec(620, 0),
    anchor: "left",
    pivot: "left",
    text: "@settings.backdrop.heading",
    text_scale: 0.14,
    wrap: true,
    markdown: true,
    align: "top_left"
});

let backdrop_shown_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_shown_name = compositor.label({
    parent: backdrop_shown_row,
    size: vec(210, 28),
    text: "@settings.backdrop.shown",
    text_scale: 0.14,
    align: "left"
});

let backdrop = compositor.toggle({
    parent: backdrop_shown_row,
    anchor: "left",
    pivot: "left",
    label: "on",
    lbl_scale: 0.14,
    state: true
});

let backdrop_wrap_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_wrap_name = compositor.label({
    parent: backdrop_wrap_row,
    size: vec(210, 28),
    text: "@settings.backdrop.wrap",
    tooltip: "@settings.backdrop.wrap_tip",
    text_scale: 0.14,
    align: "left"
});

let backdrop_wrap = compositor.toggle({
    parent: backdrop_wrap_row,
    anchor: "left",
    pivot: "left",
    label: "on",
    lbl_scale: 0.14,
    state: true
});

let backdrop_wrap_margin_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_wrap_margin_name = compositor.label({
    parent: backdrop_wrap_margin_row,
    size: vec(210, 28),
    tooltip: "@settings.backdrop.margin_tip",
    text: "@settings.backdrop.margin",
    text_scale: 0.14,
    align: "left"
});

let backdrop_wrap_margin = compositor.slider({
    parent: backdrop_wrap_margin_row,
    size: vec(200, 28),
    max: 60,
    step: 1,
    value: 8
});

let backdrop_wrap_margin_value = compositor.label({
    parent: backdrop_wrap_margin_row,
    size: vec(60, 28),
    text_scale: 0.13,
    align: "left"
});

let wrap_flow_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let wrap_flow_name = compositor.label({
    parent: wrap_flow_row,
    size: vec(210, 28),
    tooltip: "@settings.backdrop.flow_tip",
    text: "@settings.backdrop.flow",
    text_scale: 0.14,
    align: "left"
});

// Right is quicker, 0 at the left snaps
let wrap_flow = compositor.slider({
    parent: wrap_flow_row,
    size: vec(200, 28),
    max: 40,
    step: 1,
    value: 16
});

let wrap_flow_value = compositor.label({
    parent: wrap_flow_row,
    size: vec(60, 28),
    text_scale: 0.13,
    align: "left"
});

let backdrop_picture_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_picture_name = compositor.label({
    parent: backdrop_picture_row,
    size: vec(210, 28),
    text: "@settings.backdrop.picture",
    text_scale: 0.14,
    align: "left"
});

let backdrop_file = compositor.label({
    parent: backdrop_picture_row,
    size: vec(170, 28),
    text_scale: 0.13,
    align: "left"
});

let backdrop_choose = compositor.button({
    parent: backdrop_picture_row,
    size: vec(110, 28),
    label: "@settings.backdrop.choose",
    icon: "folder-opened",
    lbl_scale: 0.13
});

let backdrop_usual = compositor.button({
    parent: backdrop_picture_row,
    size: vec(120, 28),
    label: "@settings.backdrop.put_back",
    icon: "discard",
    lbl_scale: 0.13
});

let backdrop_scale_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_scale_name = compositor.label({
    parent: backdrop_scale_row,
    size: vec(210, 28),
    tooltip: "@settings.backdrop.scale_tip",
    text: "@settings.backdrop.scale",
    text_scale: 0.14,
    align: "left"
});

let backdrop_scale = compositor.slider({
    parent: backdrop_scale_row,
    size: vec(200, 28),
    progress: 0.4736842,
    min: 0.1,
    max: 2,
    step: 0.05
});

let backdrop_scale_value = compositor.label({
    parent: backdrop_scale_row,
    size: vec(60, 28),
    text_scale: 0.13,
    align: "left"
});

let backdrop_across_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_across_name = compositor.label({
    parent: backdrop_across_row,
    size: vec(210, 28),
    tooltip: "@settings.backdrop.across_tip",
    text: "@settings.backdrop.across",
    text_scale: 0.14,
    align: "left"
});

// Right of the slider is right on screen, past 0 the picture goes off the right edge and is cut off there
let backdrop_across = compositor.slider({
    parent: backdrop_across_row,
    size: vec(200, 28),
    min: -1600,
    max: 400,
    step: 10,
    value: 0
});

let backdrop_across_value = compositor.label({
    parent: backdrop_across_row,
    size: vec(60, 28),
    text_scale: 0.13,
    align: "left"
});

let backdrop_up_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_up_name = compositor.label({
    parent: backdrop_up_row,
    size: vec(210, 28),
    tooltip: "@settings.backdrop.up_tip",
    text: "@settings.backdrop.up",
    text_scale: 0.14,
    align: "left"
});

// Below 0 the picture goes off the bottom edge and is cut off there
let backdrop_up = compositor.slider({
    parent: backdrop_up_row,
    size: vec(200, 28),
    min: -400,
    max: 1200,
    step: 10,
    value: 0
});

let backdrop_up_value = compositor.label({
    parent: backdrop_up_row,
    size: vec(60, 28),
    text_scale: 0.13,
    align: "left"
});

let backdrop_opacity_row = compositor.stack({
    parent: backdrop_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let backdrop_opacity_name = compositor.label({
    parent: backdrop_opacity_row,
    size: vec(210, 28),
    tooltip: "@settings.backdrop.opacity_tip",
    text: "@settings.backdrop.opacity",
    text_scale: 0.14,
    align: "left"
});

let backdrop_opacity = compositor.slider({
    parent: backdrop_opacity_row,
    size: vec(200, 28),
    min: 0.05,
    step: 0.01
});

let backdrop_opacity_value = compositor.label({
    parent: backdrop_opacity_row,
    size: vec(60, 28),
    text_scale: 0.13,
    align: "left"
});

let designer_page = compositor.stack({
    parent: pages,
    fill: "both",
    padding: vec(14, 16, 14, 8),
    spacing: 10
});

let designer_heading = compositor.label({
    parent: designer_page,
    size: vec(620, 0),
    anchor: "left",
    pivot: "left",
    text: "@settings.designer.heading",
    text_scale: 0.14,
    wrap: true,
    markdown: true,
    align: "top_left"
});

let skin_row = compositor.stack({
    parent: designer_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let skin_name = compositor.label({
    parent: skin_row,
    size: vec(210, 28),
    tooltip: "@settings.designer.skin_tip",
    text: "@settings.designer.skin",
    text_scale: 0.14,
    align: "left"
});

let skin = compositor.selector({
    parent: skin_row,
    size: vec(260, 28),
    text_scale: 0.14
});

let layout_theme_row = compositor.stack({
    parent: designer_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let layout_theme_name = compositor.label({
    parent: layout_theme_row,
    size: vec(210, 28),
    tooltip: "@settings.designer.theme_tip",
    text: "@settings.designer.theme",
    text_scale: 0.14,
    align: "left"
});

let layout_theme = compositor.selector({
    parent: layout_theme_row,
    size: vec(260, 28),
    text_scale: 0.14
});

let snap_row = compositor.stack({
    parent: designer_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let snap_name = compositor.label({
    parent: snap_row,
    size: vec(210, 28),
    tooltip: "@settings.designer.snap_tip",
    text: "@settings.designer.snap",
    text_scale: 0.14,
    align: "left"
});

let snap = compositor.selector({
    parent: snap_row,
    size: vec(260, 28),
    text_scale: 0.14
});

let handles_row = compositor.stack({
    parent: designer_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let handles_name = compositor.label({
    parent: handles_row,
    size: vec(210, 28),
    tooltip: "@settings.designer.handles_tip",
    text: "@settings.designer.handles",
    text_scale: 0.14,
    align: "left"
});

let handles = compositor.toggle({
    parent: handles_row,
    label: "@settings.on",
    lbl_scale: 0.14
});

let files_page = compositor.stack({
    parent: pages,
    fill: "both",
    padding: vec(14, 16, 14, 8),
    spacing: 10
});

let files_heading = compositor.label({
    parent: files_page,
    size: vec(620, 0),
    anchor: "left",
    pivot: "left",
    text: "@settings.files.heading",
    text_scale: 0.14,
    wrap: true,
    markdown: true,
    align: "top_left"
});

let reopen_row = compositor.stack({
    parent: files_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let reopen_name = compositor.label({
    parent: reopen_row,
    size: vec(210, 28),
    tooltip: "@settings.files.reopen_tip",
    text: "@settings.files.reopen",
    text_scale: 0.14,
    align: "left"
});

let reopen = compositor.toggle({
    parent: reopen_row,
    label: "@settings.off",
    lbl_scale: 0.14
});

let files_note = compositor.label({
    parent: files_page,
    size: vec(620, 0),
    anchor: "left",
    pivot: "left",
    text: "@settings.files.note",
    text_scale: 0.14,
    color: vec(0.58, 0.6, 0.66, 1),
    wrap: true,
    markdown: true,
    align: "top_left"
});

let extensions_page = compositor.stack({
    parent: pages,
    fill: "both",
    padding: vec(14, 16, 14, 8),
    spacing: 12
});

let extensions_heading = compositor.stack({
    parent: extensions_page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let extensions_icon = compositor.symbol({
    parent: extensions_heading,
    size: vec(48, 48),
    hover: "pulse",
    hover_amount: 0.25,
    icon: "extensions",
    color: vec(0.36, 0.523, 0.78, 1)
});

let extensions_note = compositor.label({
    parent: extensions_heading,
    size: vec(560, 0),
    text: "@settings.extensions.page",
    text_scale: 0.14,
    wrap: true,
    markdown: true,
    align: "top_left"
});

let extensions_list = compositor.stack({
    parent: extensions_page,
    anchor: "left",
    pivot: "left",
    spacing: 14
});
