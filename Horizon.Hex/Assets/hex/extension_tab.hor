// The tab of the settings an extension gets, made from by the template of the settings' pages (settings.hor). Its name
// and what it is over the body, which is the extension's own settings layout if it has one (settings_layout in its
// extension object) or a row for every one of its settings (extension_setting.hor) if it hasn't.
#define layout

let page = compositor.stack({
    fill: "both",
    padding: vec(14, 16, 14, 8),
    spacing: 12
});

let heading = compositor.stack({
    parent: page,
    anchor: "left",
    pivot: "left",
    spacing: 12,
    direction: "horizontal"
});

let icon = compositor.symbol({
    parent: heading,
    size: vec(40, 40),
    icon: "extensions",
    color: vec(0.36, 0.523, 0.78, 1)
});

let about = compositor.label({
    parent: heading,
    size: vec(560, 0),
    text: "**Name** 1.0.0
what it does",
    text_scale: 0.14,
    wrap: true,
    markdown: true,
    align: "top_left"
});

let body = compositor.stack({
    parent: page,
    anchor: "left",
    pivot: "left",
    spacing: 6
});
