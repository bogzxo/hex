// panel, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
// The panel under the editor, what is wrong with the files, what Hex and the files that were run said, and the HIDL
// console. Included by editor.hor under the middle.
#define layout

let bottom = compositor.tabs({
    size: vec(840, 180),
    tabs: ["@panel.problems", "@panel.output", "@panel.console"],
    text_scale: 0.13,
    spacing: 18,
    resize: "top",
    min_size: vec(0, 80),
    max_size: vec(0, 600),
    slide: "down"
});

let problems_scroll = compositor.scroll({
    parent: bottom,
    fill: "both",
    padding: vec(4, 4, 4, 4)
});

let problems = compositor.stack({
    parent: problems_scroll,
    template: "tree_row.hor",
    preview_count: 2,
    spacing: 1
});

let output_scroll = compositor.scroll({
    parent: bottom,
    fill: "both",
    padding: vec(4, 4, 4, 4)
});

let output = compositor.stack({
    parent: output_scroll,
    template: "output_row.hor",
    preview_count: 3,
    spacing: 0
});

// The console, HIDL typed in and run in what the file on screen came to. What was asked and answered scrolls above, the
// line it is typed on stays along the bottom, a terminal's way. The editor sizes the two to the page, see FitConsole
let console_page = compositor.stack({
    parent: bottom,
    fill: "both",
    padding: vec(4, 4, 4, 4),
    spacing: 4
});

let console_scroll = compositor.scroll({
    parent: console_page,
    anchor: "top_left",
    pivot: "top_left",
    size: vec(816, 100)
});

let console_lines = compositor.stack({
    parent: console_scroll,
    anchor: "top_left",
    pivot: "top_left",
    template: "output_row.hor",
    preview_count: 2,
    spacing: 0
});

let console_input = compositor.textbox({
    parent: console_page,
    anchor: "left",
    pivot: "left",
    size: vec(816, 26),
    padding: vec(8, 5, 8, 5),
    placeholder: "@panel.console_placeholder",
    text_scale: 0.14,
    max_length: 400,
    tooltip: "@panel.console_tip"
});
