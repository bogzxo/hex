// editor, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.
// Hex's own window, VS Code's shape. The menus and a toolbar of icons along the top, the activity bar down the left
// and the side bar next to it, the tabs and the editor (or the canvas of a layout) in the middle with the problems
// and the output under it, the properties on the right, and the status bar along the bottom.
#define layout

let root = compositor.stack({
    fill: "both",
    spacing: 0
});

// The window's own title bar, Hex draws it (the window has no frame of the system's), with the menus in it like VS Code
let top = compositor.title_bar({
    parent: root,
    icon: "layout",
    title: "Hex",
    height: 34,
    spacing: 0
});

let menu = compositor.menu_bar({ parent: top, text_scale: 0.14 });

let toolbar = compositor.stack({
    parent: root,
    anchor: "left",
    pivot: "left",
    padding: vec(8, 2, 8, 4),
    spacing: 2,
    direction: "horizontal"
});

let new_file = compositor.button({
    parent: toolbar,
    icon: "new-file",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "A new layout (Ctrl+N)"
});

let open_file = compositor.button({
    parent: toolbar,
    icon: "folder-opened",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Open a file (Ctrl+O)"
});

let save_file = compositor.button({
    parent: toolbar,
    icon: "save",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Save (Ctrl+S)"
});

let save_all = compositor.button({
    parent: toolbar,
    icon: "save-all",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Save every file that has changes (Ctrl+Shift+S)"
});

let tools_rule1 = compositor.divider({ parent: toolbar, size: vec(1, 20), direction: "vertical" });

let undo_button = compositor.button({
    parent: toolbar,
    icon: "discard",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Undo (Ctrl+Z)"
});

let redo_button = compositor.button({
    parent: toolbar,
    icon: "redo",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Redo (Ctrl+Y)"
});

let tools_rule2 = compositor.divider({ parent: toolbar, size: vec(1, 20), direction: "vertical" });

// A layout is looked at as its designer or as its code, a file of code only as its code
let views = compositor.stack({
    parent: toolbar,
    anchor: "left",
    pivot: "left",
    spacing: 2,
    direction: "horizontal"
});

let design_view = compositor.button({
    parent: views,
    label: "Design",
    icon: "layout",
    style: "button_flat",
    size: vec(0, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "The canvas and everything for putting a layout together (F7)"
});

let code_view = compositor.button({
    parent: views,
    label: "Code",
    icon: "code",
    style: "button_flat",
    size: vec(0, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "The code the layout is written as, what is typed goes back into it on the way to the designer (F7)"
});

let tools_rule3 = compositor.divider({ parent: toolbar, size: vec(1, 20), direction: "vertical" });

let play_button = compositor.button({
    parent: toolbar,
    label: "Run",
    icon: "play",
    style: "button_flat",
    size: vec(0, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Runs the file, or plays the entrances of a layout from the start the way loading it does (F5)"
});

let find_button = compositor.button({
    parent: toolbar,
    icon: "search",
    style: "button_flat",
    size: vec(30, 28),
    lbl_scale: 0.14,
    animated: false,
    tooltip: "Find in every file (Ctrl+Shift+F)"
});

let name_box = compositor.textbox({
    parent: toolbar,
    size: vec(200, 26),
    padding: vec(8, 5, 8, 5),
    placeholder: "name of the layout",
    text_scale: 0.14,
    max_length: 40,
    tooltip: "What the layout is called, which is the name of its file"
});

let body = compositor.stack({
    parent: root,
    anchor: "left",
    pivot: "left",
    spacing: 0,
    direction: "horizontal"
});

// The activity bar, which of the side bar's views is showing
let activity = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    padding: vec(4, 4, 4, 4),
    spacing: 4
});

let act_explorer = compositor.button({
    parent: activity,
    icon: "files",
    style: "button_flat",
    size: vec(38, 38),
    lbl_scale: 0.2,
    animated: false,
    tooltip: "Explorer, the folders of the workspace (Ctrl+Shift+E)"
});

let act_search = compositor.button({
    parent: activity,
    icon: "search",
    style: "button_flat",
    size: vec(38, 38),
    lbl_scale: 0.2,
    animated: false,
    tooltip: "Search, what was found in every file (Ctrl+Shift+F)"
});

let act_outline = compositor.button({
    parent: activity,
    icon: "list-tree",
    style: "button_flat",
    size: vec(38, 38),
    lbl_scale: 0.2,
    animated: false,
    tooltip: "Outline, what the file declares (Ctrl+Shift+O)"
});

let act_design = compositor.button({
    parent: activity,
    icon: "layout",
    style: "button_flat",
    size: vec(38, 38),
    lbl_scale: 0.2,
    animated: false,
    tooltip: "The designer's toolbox, components and layers (Ctrl+Shift+O)"
});

let act_settings = compositor.button({
    parent: activity,
    icon: "settings-gear",
    style: "button_flat",
    size: vec(38, 38),
    lbl_scale: 0.2,
    animated: false,
    tooltip: "Settings (Ctrl+,)"
});

let left = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    padding: vec(6, 6, 6, 6),
    spacing: 6
});

let tree_title = compositor.label({
    parent: left,
    anchor: "left",
    pivot: "left",
    text: "EXPLORER",
    text_scale: 0.14,
    color: vec(0.46, 0.52, 0.64, 1)
});

let toolbox = compositor.collapsible({
    parent: left,
    anchor: "left",
    pivot: "left",
    title: "TOOLBOX",
    text_scale: 0.13,
    spacing: 4
});

// As tall as the side bar can spare, scrolled when there isn't room for all of it (the editor sizes it, see FitChrome)
let palette_scroll = compositor.scroll({
    parent: toolbox,
    size: vec(280, 200)
});

let palette = compositor.grid({
    parent: palette_scroll,
    template: "palette_button.hor",
    preview_count: 19,
    spacing: 4
});

let tree_tools = compositor.stack({
    parent: left,
    anchor: "left",
    pivot: "left",
    spacing: 2,
    direction: "horizontal"
});

let move_up = compositor.button({
    parent: tree_tools,
    icon: "arrow-up",
    style: "button_flat",
    size: vec(30, 26),
    lbl_scale: 0.14,
    animated: false
});

let move_down = compositor.button({
    parent: tree_tools,
    icon: "arrow-down",
    style: "button_flat",
    size: vec(30, 26),
    lbl_scale: 0.14,
    animated: false
});

let move_out = compositor.button({
    parent: tree_tools,
    icon: "arrow-left",
    style: "button_flat",
    size: vec(30, 26),
    lbl_scale: 0.14,
    animated: false
});

let move_in = compositor.button({
    parent: tree_tools,
    icon: "arrow-right",
    style: "button_flat",
    size: vec(30, 26),
    lbl_scale: 0.14,
    animated: false
});

let duplicate = compositor.button({
    parent: tree_tools,
    icon: "copy",
    style: "button_flat",
    size: vec(30, 26),
    lbl_scale: 0.14,
    animated: false
});

let remove = compositor.button({
    parent: tree_tools,
    icon: "trash",
    style: "button_flat",
    size: vec(30, 26),
    lbl_scale: 0.14,
    animated: false
});

let tree_scroll = compositor.scroll({
    parent: left,
    size: vec(280, 380),
    padding: vec(4, 4, 4, 4),
    color: vec(0.1, 0.11, 0.145, 1),
    radius: 6
});

let tree = compositor.stack({
    parent: tree_scroll,
    template: "tree_row.hor",
    preview_count: 5,
    spacing: 1
});

let layers_section = compositor.collapsible({
    parent: left,
    anchor: "left",
    pivot: "left",
    title: "LAYERS",
    text_scale: 0.13,
    spacing: 4
});

let layers_scroll = compositor.scroll({
    parent: layers_section,
    size: vec(280, 96),
    padding: vec(4, 4, 4, 4),
    color: vec(0.1, 0.11, 0.145, 1),
    radius: 6
});

let layers = compositor.stack({
    parent: layers_scroll,
    template: "tree_row.hor",
    preview_count: 2,
    spacing: 1
});

let center = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    padding: vec(0, 6, 0, 0),
    spacing: 0
});

let doc_tabs = compositor.tab_strip({ parent: center, size: vec(884, 0) });

let crumbs = compositor.breadcrumbs({ parent: center, size: vec(884, 0), padding: vec(6, 0, 6, 0) });

let canvas = compositor.panel({ parent: center, size: vec(884, 497) });

// Where the code of whatever is open is edited, the editor of the document that is showing goes in here
let code_scroll = compositor.panel({
    parent: center,
    size: vec(884, 250),
    color: vec(0.055, 0.06, 0.08, 1)
});

// The panel under the editor, what is wrong with the files and what Hex and the files that were run said
let bottom = compositor.tabs({
    parent: center,
    size: vec(884, 180),
    tabs: ["$(error) PROBLEMS", "$(output) OUTPUT"],
    text_scale: 0.13,
    spacing: 18,
    resize: "top",
    min_size: vec(0, 80),
    max_size: vec(0, 600)
});

let problems_scroll = compositor.scroll({
    parent: bottom,
    fill: "both",
    padding: vec(4, 4, 4, 4)
});

let problems = compositor.stack({
    parent: problems_scroll,
    template: "tree_row.hor",
    preview_count: 2,
    spacing: 1
});

let output_scroll = compositor.scroll({
    parent: bottom,
    fill: "both",
    padding: vec(4, 4, 4, 4)
});

let output = compositor.stack({
    parent: output_scroll,
    template: "output_row.hor",
    preview_count: 3,
    spacing: 0
});

let right = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    padding: vec(6, 6, 6, 6),
    spacing: 6
});

let inspector_title = compositor.label({
    parent: right,
    anchor: "left",
    pivot: "left",
    text: "PROPERTIES",
    text_scale: 0.14,
    color: vec(0.46, 0.52, 0.64, 1)
});

let inspector_scroll = compositor.scroll({
    parent: right,
    size: vec(400, 789.7115),
    padding: vec(8, 8, 8, 8),
    color: vec(0.1, 0.11, 0.145, 1),
    radius: 6
});

let inspector = compositor.stack({
    parent: inspector_scroll,
    template: "property_row.hor",
    preview_count: 6,
    spacing: 5
});

let status_bar = compositor.status_bar({ parent: root, fill: "horizontal" });
