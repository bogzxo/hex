// The settings, a window of their own in the editor with a page for each part of it. The code finds what sets each
// setting by its name and fills in its choices, the look of it all is here.
#define layout

let window = compositor.window({
    anchor: "center",
    size: vec(700, 480),
    min_size: vec(520, 320),
    title: "Settings",
    icon: "settings-gear",
    closable: true,
    resize_grip: true,
    z: 10,
    padding: vec(8, 8, 8, 8)
});

let pages = compositor.tabs({
    parent: window,
    fill: "both",
    tabs: ["$(settings-gear) Editor", "$(layout) Designer", "$(files) Files", "$(extensions) Extensions"],
    text_scale: 0.14,
    spacing: 22
});

let editor_page = compositor.stack({ parent: pages, fill: "both", padding: vec(14, 16, 14, 8), spacing: 10 });
let designer_page = compositor.stack({ parent: pages, fill: "both", padding: vec(14, 16, 14, 8), spacing: 10 });
let files_page = compositor.stack({ parent: pages, fill: "both", padding: vec(14, 16, 14, 8), spacing: 10 });
let extensions_page = compositor.stack({ parent: pages, fill: "both", padding: vec(14, 16, 14, 8), spacing: 12 });

let editor_heading = compositor.label({
    parent: editor_page,
    anchor: "left",
    size: vec(620, 0),
    text: "## The editor\nHow Hex itself looks. Its own skin is the flat one, in one of its themes.",
    text_scale: 0.14,
    align: "top_left",
    markdown: true,
    wrap: true
});

let theme_row = compositor.stack({ parent: editor_page, anchor: "left", direction: "horizontal", spacing: 12 });
let theme_name = compositor.label({ parent: theme_row, size: vec(210, 28), text: "Skin", text_scale: 0.14, align: "left", tooltip: "The skin the editor itself is drawn in, any of them in any of their themes, however obnoxious" });
let theme = compositor.dropdown({ parent: theme_row, size: vec(260, 28), text_scale: 0.14, max_rows: 12 });

let size_row = compositor.stack({ parent: editor_page, anchor: "left", direction: "horizontal", spacing: 12 });
let size_name = compositor.label({ parent: size_row, size: vec(210, 28), text: "Size", text_scale: 0.14, align: "left", tooltip: "How big the editor draws itself and the layouts in it" });
let size = compositor.selector({ parent: size_row, size: vec(260, 28), text_scale: 0.14 });

let code_zoom_row = compositor.stack({ parent: editor_page, anchor: "left", direction: "horizontal", spacing: 12 });
let code_zoom_name = compositor.label({ parent: code_zoom_row, size: vec(210, 28), text: "Code size", text_scale: 0.14, align: "left", tooltip: "How big the code is drawn against the rest of the editor, Ctrl+= and Ctrl+- in code" });
let code_zoom = compositor.selector({ parent: code_zoom_row, size: vec(260, 28), text_scale: 0.14 });

let panels_row = compositor.stack({ parent: editor_page, anchor: "left", direction: "horizontal", spacing: 12 });
let panels_name = compositor.label({ parent: panels_row, size: vec(210, 28), text: "Panels", text_scale: 0.14, align: "left", tooltip: "The side bar, the properties, the panel under the editor and the layers, as wide and as tall as they come" });
let panels = compositor.button({ parent: panels_row, size: vec(260, 28), label: "Put them back", icon: "discard", lbl_scale: 0.14 });

let designer_heading = compositor.label({
    parent: designer_page,
    anchor: "left",
    size: vec(620, 0),
    text: "## The designer\nHow layouts are shown and put together on the canvas.",
    text_scale: 0.14,
    align: "top_left",
    markdown: true,
    wrap: true
});

let skin_row = compositor.stack({ parent: designer_page, anchor: "left", direction: "horizontal", spacing: 12 });
let skin_name = compositor.label({ parent: skin_row, size: vec(210, 28), text: "Layouts are shown in", text_scale: 0.14, align: "left", tooltip: "The skin the layouts in the canvas are drawn in, the game's setting and not the editor's, the same as the View menu's" });
let skin = compositor.selector({ parent: skin_row, size: vec(260, 28), text_scale: 0.14 });

// Only there for a skin that has themes, the code shows it and hides it
let layout_theme_row = compositor.stack({ parent: designer_page, anchor: "left", direction: "horizontal", spacing: 12 });
let layout_theme_name = compositor.label({ parent: layout_theme_row, size: vec(210, 28), text: "In its theme", text_scale: 0.14, align: "left", tooltip: "The theme of the skin the layouts are shown in, the colour of its art" });
let layout_theme = compositor.selector({ parent: layout_theme_row, size: vec(260, 28), text_scale: 0.14 });

let snap_row = compositor.stack({ parent: designer_page, anchor: "left", direction: "horizontal", spacing: 12 });
let snap_name = compositor.label({ parent: snap_row, size: vec(210, 28), text: "Snap to a grid", text_scale: 0.14, align: "left", tooltip: "What positions and sizes land on when something is dragged in the canvas" });
let snap = compositor.selector({ parent: snap_row, size: vec(260, 28), text_scale: 0.14 });

let handles_row = compositor.stack({ parent: designer_page, anchor: "left", direction: "horizontal", spacing: 12 });
let handles_name = compositor.label({ parent: handles_row, size: vec(210, 28), text: "Resize handles", text_scale: 0.14, align: "left", tooltip: "Whether what is selected in the canvas can be dragged bigger by its edges" });
let handles = compositor.toggle({ parent: handles_row, label: "on", lbl_scale: 0.14 });

let files_heading = compositor.label({
    parent: files_page,
    anchor: "left",
    size: vec(620, 0),
    text: "## Files\nWhat Hex opens and where it keeps things.",
    text_scale: 0.14,
    align: "top_left",
    markdown: true,
    wrap: true
});

let reopen_row = compositor.stack({ parent: files_page, anchor: "left", direction: "horizontal", spacing: 12 });
let reopen_name = compositor.label({ parent: reopen_row, size: vec(210, 28), text: "Open the last layout", text_scale: 0.14, align: "left", tooltip: "Whether the editor starts with the layout that was worked on last" });
let reopen = compositor.toggle({ parent: reopen_row, label: "off", lbl_scale: 0.14 });

let files_note = compositor.label({
    parent: files_page,
    anchor: "left",
    size: vec(620, 0),
    text: "Hex keeps its settings in `hex_settings.hor` next to it, and the workspace that was open last comes back when it starts.",
    text_scale: 0.14,
    color: vec(0.58, 0.6, 0.66, 1),
    align: "top_left",
    markdown: true,
    wrap: true
});

// A page for what is to come
let extensions_icon = compositor.symbol({
    parent: extensions_page,
    size: vec(64, 64),
    icon: "extensions",
    color: vec(0.36, 0.78, 0.6, 1)
});

let extensions_note = compositor.label({
    parent: extensions_page,
    size: vec(440, 0),
    text: "## Extensions\nWork in progress. One day Hex will take extensions of its own here.",
    text_scale: 0.14,
    align: "center",
    markdown: true,
    wrap: true
});
