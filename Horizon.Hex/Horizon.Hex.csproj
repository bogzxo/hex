<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>

    <!-- Hex's own version, what About says and the changelog (Help, What changed) goes up to -->
    <Version>0.1.0</Version>

    <!-- The dialogs for opening and saving a layout are asked for from Windows directly, see HexDialogs.cs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Where the engine is, its submodule unless a workspace said otherwise -->
    <HorizonRoot Condition="'$(HorizonRoot)' == ''">$(MSBuildThisFileDirectory)..\horizon\</HorizonRoot>
  </PropertyGroup>

  <!--
    Publishing: dotnet publish -c Release -r win-x64
    That makes a native Horizon.Hex.exe (trimmed, no .NET needed on the machine it is run on) next to the Assets
    and shaders it loads, which is the folder to hand out.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    The native compiler asks Visual Studio where its linker is (vcvarsall.bat), and newer Visual Studios run
    vswhere.exe for that without saying where it is: it is only found if its folder is on the PATH, which it isn't
    outside of a developer prompt. So the folder is put on the PATH of the build before any of that happens.
  -->
  <UsingTask TaskName="AddToPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Directory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string path = System.Environment.GetEnvironmentVariable("PATH") ?? "";
        if (System.IO.Directory.Exists(Directory) && path.IndexOf(Directory, System.StringComparison.OrdinalIgnoreCase) < 0)
            System.Environment.SetEnvironmentVariable("PATH", Directory + ";" + path);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FindVisualStudioLocator" BeforeTargets="SetupOSSpecificProps" Condition="'$(OS)' == 'Windows_NT' and '$(PublishAot)' == 'true'">
    <AddToPath Directory="$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer" />
  </Target>

  <ItemGroup>
    <Compile Remove="Milestone Builds\**" />
    <EmbeddedResource Remove="Milestone Builds\**" />
    <None Remove="Milestone Builds\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\hex\**\*.hor">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The engine is a submodule at horizon/, the language a submodule inside of that. A workspace above this repo
         (Directory.Build.props) can say to use another checkout of the engine instead, see HorizonRoot -->
    <ProjectReference Include="$(HorizonRoot)Horizon\Horizon.csproj" />
    <ProjectReference Include="$(HorizonRoot)Horizon.HIDL\Horizon.HIDL.csproj" />
  </ItemGroup>

</Project>
